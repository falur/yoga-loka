APP_ENV=local
DEBUG=true
VERBOSITY_LEVEL=debug
ENCRYPTER_KEY={encrypt-key}

COMPOSE_PROJECT_NAME=yoga-loka-spiral-2

APP_HOST_PORT=60080
POSTGRES_HOST_PORT=65432
REDIS_HOST_PORT=60379
CENTRIFUGO_HOST_PORT=60000
MINIO_HOST_PORT=60900
MINIO_CONSOLE_HOST_PORT=60901
MAILPIT_SMTP_HOST_PORT=61025
MAILPIT_WEB_HOST_PORT=60825
TEMPORAL_HOST_PORT=62333
TEMPORAL_UI_HOST_PORT=62334
RABBITMQ_HOST_PORT=60672
RABBITMQ_MANAGEMENT_HOST_PORT=61672

MONOLOG_DEFAULT_CHANNEL=default
MONOLOG_DEFAULT_LEVEL=DEBUG

QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=yoga_loka
RABBITMQ_PASSWORD=yoga_loka_password
# RABBITMQ_VHOST — имя vhost в RabbitMQ. Для нестандартного vhost используй `staging`.
RABBITMQ_VHOST=/
# RABBITMQ_URL_VHOST — path-часть AMQP-адреса RoadRunner. Для того же `staging` используй `/staging`.
RABBITMQ_URL_VHOST=/
RABBITMQ_QUEUE_NAME=yoga_loka_jobs
RABBITMQ_QUEUE_PREFETCH=100
RABBITMQ_QUEUE_DURABLE=true
RABBITMQ_EXCHANGE_NAME=yoga_loka_jobs
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_EXCHANGE_DURABLE=true
RABBITMQ_ROUTING_KEY=yoga_loka_jobs
RABBITMQ_REQUEUE_ON_FAIL=false

OUTBOX_MAX_ATTEMPTS=100
OUTBOX_MAX_CONSECUTIVE_RELAY_FAILURES=10
OUTBOX_BASE_RELAY_RETRY_DELAY_SECONDS=1
OUTBOX_MAX_RELAY_RETRY_DELAY_SECONDS=30
OUTBOX_CLAIM_TIMEOUT_SECONDS=60
OUTBOX_PUBLISH_RETRY_DELAY_SECONDS=60

CACHE_STORAGE=redis
REDIS_DSN=redis://redis:6379/0
REDIS_CACHE_NAMESPACE=yoga_loka_cache
REDIS_CACHE_DEFAULT_LIFETIME=0

SESSION_LIFETIME=86400
SESSION_COOKIE=sid
SESSION_CACHE_STORAGE=redis
SESSION_CACHE_PREFIX=session:

STORAGE_DEFAULT=s3
S3_REGION=us-east-1
S3_VERSION=latest
S3_BUCKET=yoga-loka
S3_TEST_BUCKET=yoga-loka-test
S3_KEY=yoga_loka
S3_SECRET=yoga_loka_password
S3_ENDPOINT=http://minio:9000
S3_VISIBILITY=public

MEDIA_UPLOAD_STORAGE_SERVER=s3
MEDIA_UPLOAD_STORAGE_BUCKET=media-upload
MEDIA_UPLOAD_STORAGE_PREFIX=
MEDIA_PRIVATE_STORAGE_SERVER=s3
MEDIA_PRIVATE_STORAGE_BUCKET=media-private
MEDIA_PRIVATE_STORAGE_PREFIX=
MEDIA_PUBLIC_STORAGE_SERVER=s3
MEDIA_PUBLIC_STORAGE_BUCKET=media-public
MEDIA_PUBLIC_STORAGE_PREFIX=

# Инфраструктурные параметры пайплайна загрузки Media (app/config/media.php).
MEDIA_STAGING_TTL_SECONDS=86400
# Срок presigned-ссылки скачивания по умолчанию, секунды (диапазон 1..604800).
MEDIA_PRESIGNED_TTL_SECONDS=3600
MEDIA_MULTIPART_THRESHOLD_BYTES=16777216
MEDIA_MULTIPART_PART_SIZE_BYTES=8388608
MEDIA_IMAGE_PROCESSING_DRIVER=imagick
# Транскодирование видео/аудио через ffmpeg (app/config/media.php). Пути — к бинарям в образе.
MEDIA_FFMPEG_BINARY=/usr/bin/ffmpeg
MEDIA_FFPROBE_BINARY=/usr/bin/ffprobe
MEDIA_FFMPEG_TIMEOUT_SECONDS=1800
MEDIA_FFMPEG_THREADS=0

MINIO_ROOT_USER=yoga_loka
MINIO_ROOT_PASSWORD=yoga_loka_password
MINIO_TEST_BUCKET=yoga-loka-test

TELEMETRY_DRIVER=null
TOKENIZER_CACHE_TARGETS=false
TOKENIZER_LOAD_CLASSES=true
TOKENIZER_LOAD_ENUMS=true
TOKENIZER_LOAD_INTERFACES=true
VIEW_CACHE=false

AUTH_TOKEN_TRANSPORT=cookie
AUTH_TOKEN_STORAGE=session

MAILER_DSN=smtp://mailpit:1025
MAILER_QUEUE=local
MAILER_QUEUE_CONNECTION=null
MAILER_FROM="YogaLoka <sendit@local.host>"

SAFE_MIGRATIONS=true

DB_CONNECTION=pgsql
DB_LOG_QUERY_PARAMETERS=true
DB_LOG_INTERPOLATED_QUERIES=false
DB_WITH_DATETIME_MICROSECONDS=false
DB_DATABASE=yoga_loka
DB_TEST_DATABASE=yoga_loka_test
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password

CYCLE_SCHEMA_CACHE=false
CYCLE_SCHEMA_WARMUP=false

SENTRY_DSN=null

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_TASK_QUEUE=default

CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_HMAC_SECRET=dev-centrifugo-token-secret
CENTRIFUGO_ADMIN_PASSWORD=dev-centrifugo-admin-password
CENTRIFUGO_ADMIN_SECRET=dev-centrifugo-admin-secret

# FCM (push-уведомления). Service-account JSON — вне репозитория.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

LOCALE=ru
FALLBACK_LOCALE=ru
