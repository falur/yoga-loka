{
    "name": "spiral/app",
    "type": "project",
    "license": "MIT",
    "description": "Spiral Application installer",
    "homepage": "https://spiral.dev",
    "support": {
        "issues": "https://github.com/spiral/app/issues",
        "source": "https://github.com/spiral/app"
    },
    "require": {
        "php": ">=8.5 <8.6",
        "spiral/framework": "^3.15.7",
        "spiral/roadrunner-cli": "^2.5",
        "spiral/http": "^3.15",
        "ext-mbstring": "*",
        "spiral/nyholm-bridge": "^1.3",
        "spiral/roadrunner-bridge": "^4.0",
        "ext-sockets": "*",
        "spiral-packages/yii-error-handler-bridge": "^1.1",
        "spiral/cycle-bridge": "^2.11",
        "illuminate/collections": "8 - 12",
        "spiral-packages/symfony-validator": "^1.5",
        "spiral/twig-bridge": "^2.0.1",
        "spiral/data-grid-bridge": "^3.0.1",
        "spiral-packages/league-event": "^1.0.1",
        "spiral-packages/scheduler": "^2.1",
        "spiral/translator": "^3.15",
        "spiral/temporal-bridge": "^3.3",
        "spiral/sentry-bridge": "^2.3"
    },
    "require-dev": {
        "spiral/code-style": "^2.2",
        "spiral/testing": "^3.0",
        "spiral/dumper": "^3.3.1",
        "yoga-loka/phpstan-rules": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "tools/phpstan",
            "options": {
                "symlink": true
            }
        }
    ],
    "extra": {
        "publish-cmd": "php app.php publish"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "spiral/composer-publish-plugin": true
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "php app.php encrypt:key -m .env",
            "php app.php configure --quiet",
            "rr get-binary --quiet",
            "composer dump-autoload"
        ],
        "rr:download": "rr get-binary",
        "rr:download-protoc": "rr download-protoc-binary",
        "cs:fix": "php-cs-fixer fix -v",
        "phpstan": [
            "phpstan analyse",
            "@phpstan-rules:phpstan"
        ],
        "phpstan-rules:phpstan": "phpstan analyse -c tools/phpstan/phpstan.neon",
        "phpstan-rules:test": "phpunit -c tools/phpstan/phpunit.xml",
        "test": [
            "phpunit",
            "@phpstan-rules:test"
        ],
        "test-coverage": "phpunit --coverage"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
