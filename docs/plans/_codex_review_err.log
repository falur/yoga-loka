    25	    #[\Override]
    26	    public function runOnce(OutboxRelayBatchSize $outboxRelayBatchSize): int
    27	    {
    28	        return $this->outboxRelay->relay(outboxRelayBatchSize: $outboxRelayBatchSize);
    29	    }
    30	
    31	    #[\Override]
    32	    public function runLoop(OutboxRelayBatchSize $outboxRelayBatchSize, int $sleepSeconds): never
    33	    {
    34	        $retryAttempts = 0;
    35	
    36	        while ($this->outboxRelayLoopControl->shouldContinue()) {
    37	            try {
    38	                $publishedCount = $this->outboxRelay->relay(outboxRelayBatchSize: $outboxRelayBatchSize);
    39	                $retryAttempts = 0;
    40	
    41	                if ($publishedCount === 0 && $sleepSeconds > 0) {
    42	                    \sleep($sleepSeconds);
    43	                }
    44	            } catch (\Throwable $exception) {
    45	                $retryAttempts++;
    46	                $retryDelaySeconds = $this->calculateRetryDelaySeconds(
    47	                    sleepSeconds: $sleepSeconds,
    48	                    retryAttempts: $retryAttempts,
    49	                );
    50	
    51	                $this->logger->warning(message: 'Outbox relay поймал ошибку в цикле и продолжает через паузу.', context: [
    52	                    'errorClass' => $exception::class,
    53	                    'errorMessage' => $exception->getMessage(),
    54	                    'outboxBatchSize' => $outboxRelayBatchSize->value(),
    55	                    'retryAttempts' => $retryAttempts,
    56	                    'retryDelaySeconds' => $retryDelaySeconds,
    57	                ]);
    58	
    59	                if ($retryAttempts >= self::MAX_CONSECUTIVE_RELAY_FAILURES) {
    60	                    $this->logger->error(message: 'Outbox relay остановлен после серии ошибок в постоянном режиме.', context: [
    61	                        'errorClass' => $exception::class,
    62	                        'errorMessage' => $exception->getMessage(),
    63	                        'retryAttempts' => $retryAttempts,
    64	                        'outboxBatchSize' => $outboxRelayBatchSize->value(),
    65	                    ]);
    66	
    67	                    throw $exception;
    68	                }
    69	
    70	                if ($retryDelaySeconds > 0) {
    71	                    \sleep($retryDelaySeconds);
    72	                }
    73	            }
    74	        }
    75	
    76	        throw new \RuntimeException('Outbox relay loop остановлен внешним контролем.');
    77	    }
    78	
    79	    private function calculateRetryDelaySeconds(int $sleepSeconds, int $retryAttempts): int
    80	    {
    81	        $baseDelay = \max(self::BASE_RELAY_RETRY_DELAY_SECONDS, $sleepSeconds);
    82	
    83	        $retryDelayMultiplier = $retryAttempts ** 2 - $retryAttempts + 1;
    84	
    85	        return \min(self::MAX_RELAY_RETRY_DELAY_SECONDS, $baseDelay * $retryDelayMultiplier);
    86	    }
    87	}

