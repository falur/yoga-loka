    13	final readonly class OutboxRelayWorker implements OutboxRelayWorkerContract
    14	{
    15	    private const int MAX_CONSECUTIVE_RELAY_FAILURES = 10;
    16	    private const int BASE_RELAY_RETRY_DELAY_SECONDS = 1;
    17	    private const int MAX_RELAY_RETRY_DELAY_SECONDS = 30;
    18	
    19	    public function __construct(
    20	        private OutboxRelayContract $outboxRelay,
