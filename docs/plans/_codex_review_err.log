    47	        } catch (\RuntimeException $exception) {
    48	            self::assertSame('Outbox relay loop остановлен внешним контролем.', $exception->getMessage());
    49	            self::assertSame(2, $calls);
    50	            self::assertSame(1, $logger->warningCount);
    51	        }
    52	    }
    53	}
    54	
    55	final class FixedOutboxRelayLoopControl implements OutboxRelayLoopControlContract
    56	{
    57	    private int $currentIteration = 0;
    58	
    59	    public function __construct(
    60	        private readonly int $iterations,
    61	    ) {}
    62	
    63	    #[\Override]
    64	    public function shouldContinue(): bool
    65	    {
    66	        $this->currentIteration++;
    67	
    68	        return $this->currentIteration <= $this->iterations;
    69	    }
    70	}
    71	
    72	final class RecordingLogger extends AbstractLogger
    73	{
    74	    public int $warningCount = 0;
    75	    public int $errorCount = 0;
    76	    public int $debugCount = 0;
    77	
    78	    /**
    79	     * @var list<array<string, mixed>>
    80	     */
    81	    private array $records = [];
    82	
    83	    /**
    84	     * @param array<string, mixed> $context
    85	     */
    86	    #[\Override]
    87	    public function log($level, \Stringable|string $message, array $context = []): void
    88	    {
    89	        $this->records[] = [
    90	            'level' => (string) $level,
    91	            'message' => (string) $message,
    92	            'context' => $context,
    93	        ];
    94	
    95	        match ((string) $level) {
    96	            'warning' => $this->warningCount++,
    97	            'error' => $this->errorCount++,
    98	            'debug' => $this->debugCount++,
    99	            default => null,
   100	        };
   101	    }
   102	}

