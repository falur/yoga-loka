   299	            partsCount: MediaMultipartPartsCount::fromInt(1),
   300	            partSize: MediaMultipartPartSize::fromInt(5_242_880),
   301	            fileSize: MediaFileSize::fromInt(5_242_880),
   302	        );
   303	        $multipartUpload->replaceParts(new MediaMultipartPartCollection([
   304	            MediaMultipartPart::create(
   305	                partNumber: MediaMultipartPartNumber::fromInt(1),
   306	                eTag: MediaMultipartPartETag::fromString('first'),
   307	            ),
   308	        ]));
   309	
   310	        return $multipartUpload;
   311	    }
