   263	            media: $media,
   264	            type: MediaImageConversionType::Thumbnail,
   265	            status: MediaConversionStatus::Ready,
   266	            storage: MediaStorage::Public,
   267	            path: MediaPath::fromString(\sprintf('images/%s/%s/thumbnail.jpg', $storageKey->shard(), $storageKey)),
   268	            mimeType: MediaMimeType::fromString('image/jpeg'),
   269	            size: MediaFileSize::fromInt(512),
   270	            width: MediaPixelDimension::fromInt(100),
   271	            height: MediaPixelDimension::fromInt(100),
   272	        );
   273	    }
