   284	            path: MediaPath::fromString(\sprintf('videos/%s/%s/normalized.mp4', $storageKey->shard(), $storageKey)),
   285	            mimeType: MediaMimeType::fromString('video/mp4'),
   286	            size: MediaFileSize::fromInt(2048),
