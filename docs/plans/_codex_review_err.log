   136	    private function pendingForRelayRows(\DateTimeImmutable $now): array
   137	    {
   138	        $databaseRows = $this->database
   139	            ->select([
   140	                'id',
   141	                'type',
   142	                'payload',
   143	                'status',
   144	                'attempts',
   145	                'available_at',
   146	                'queued_at',
   147	                'handled_at',
   148	                'failed_at',
   149	                'created_at',
   150	                'updated_at',
   151	                'last_error',
   152	            ])
   153	            ->from('outbox_events')
   154	            ->where('status', 'in', new Parameter([
   155	                OutboxEventStatus::Pending->value,
   156	                OutboxEventStatus::Publishing->value,
   157	            ]))
   158	            ->where('available_at', '<=', $now)
   159	            ->orderBy(expression: 'id', direction: 'ASC')
   160	            ->fetchAll();
   161	
   162	        $pendingRows = [];
   163	
   164	        foreach ($databaseRows as $databaseRow) {
   165	            if (!\is_array($databaseRow)) {
