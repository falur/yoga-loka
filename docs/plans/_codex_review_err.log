    volumes:
      - postgres-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USERNAME:-postgres} -d postgres"]
      interval: 5s
      timeout: 5s
      retries: 20

  postgres-init:
    image: postgres:18.3-bookworm
    environment:
      POSTGRES_USER: ${DB_USERNAME:-postgres}
      POSTGRES_PASSWORD: ${DB_PASSWORD:-password}
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      POSTGRES_DATABASES: yoga_loka yoga_loka_test temporal temporal_visibility
    volumes:
      - ./postgres/ensure-databases.sh:/usr/local/bin/ensure-databases.sh:ro
    command: ["bash", "/usr/local/bin/ensure-databases.sh"]
    depends_on:
      postgres:
        condition: service_healthy
    restart: "no"

  redis:
    image: redis:8.6.3-trixie
    command: ["redis-server", "--appendonly", "yes"]
    ports:
      - "127.0.0.1:${REDIS_HOST_PORT:-60379}:6379"
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 20

  minio:
    image: quay.io/minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
    command: ["server", "/data", "--console-address", ":9001"]
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-yoga_loka}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-yoga_loka_password}
    ports:
      - "127.0.0.1:${MINIO_HOST_PORT:-60900}:9000"
      - "127.0.0.1:${MINIO_CONSOLE_HOST_PORT:-60901}:9001"
    volumes:
      - minio-data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 5s
      retries: 20

  minio-init:
    image: minio/mc:latest
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-yoga_loka}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-yoga_loka_password}
      MINIO_ENDPOINT: http://minio:9000
