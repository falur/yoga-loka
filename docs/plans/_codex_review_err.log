name: ${COMPOSE_PROJECT_NAME:-yoga-loka-spiral-2}

services:
  app-http:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    working_dir: /app
    env_file:
      - ../.env
    command: ["rr", "serve", "-c", "docker/rr/http-jobs.yaml", "-w", "/app"]
    volumes:
      - ..:/app
      - app-runtime:/app/runtime
    ports:
      - "127.0.0.1:${APP_HOST_PORT:-60080}:8080"
    depends_on:
      postgres-init:
        condition: service_completed_successfully
      redis:
        condition: service_healthy
      minio-init:
        condition: service_completed_successfully
      mailpit:
        condition: service_started
      rabbitmq:
        condition: service_healthy
      temporal:
        condition: service_healthy
      centrifugo:
        condition: service_started

  temporal-worker:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    working_dir: /app
    env_file:
      - ../.env
    command: ["rr", "serve", "-c", "docker/rr/temporal-worker.yaml", "-w", "/app"]
    volumes:
      - ..:/app
      - temporal-worker-runtime:/app/runtime
    depends_on:
      postgres-init:
        condition: service_completed_successfully
      temporal:
