   243	    ): Media {
   244	        $storageKey ??= MediaStorageKey::generate();
   245	
   246	        return Media::create(
   247	            storageKey: $storageKey,
   248	            type: MediaType::Image,
   249	            visibility: MediaVisibility::Private,
   250	            path: MediaPath::originalUpload(storageKey: $storageKey, extension: 'jpg'),
   251	            mimeType: MediaMimeType::fromString('image/jpeg'),
   252	            size: MediaFileSize::fromInt(1024),
   253	            uploadedById: UserId::generate(),
   254	            expiration: $expiration ?? MediaExpiration::temporaryUntil(new \DateTimeImmutable('+1 hour')),
   255	        );
   256	    }
