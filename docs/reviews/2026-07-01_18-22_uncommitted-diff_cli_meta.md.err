    12	
    13	/**
    14	 * Best-effort разрешение ссылки ТОЛЬКО на оригинал медиа по его id, для потребителей, которым
    15	 * конверсии не нужны (аватар профиля). В отличие от FindMediaUrl, грузит медиа без конверсий
    16	 * (findById, без ->load(...)) и строит только оригинал, не обращаясь к связям-конверсиям — это
    17	 * убирает три лишних загрузки связей и подписание ссылок конверсий, результат которых тут же
    18	 * отбрасывался бы.
    19	 *
    20	 * Возвращает null, если медиа нет, оно не финализировано или оригинал удалён (readyOriginalRemoved),
    21	 * чтобы вызывающий подставил значение по умолчанию без try-catch.
    22	 */
    23	final readonly class FindMediaOriginalUrlHandler
    24	{
    25	    public function __construct(
    26	        private MediaRepository $mediaRepository,
    27	        private MediaUrlServiceContract $mediaUrlService,
    28	    ) {}
    29	
    30	    #[LogOperation]
    31	    public function handle(FindMediaOriginalUrlQuery $query): MediaUrlResult|null
    32	    {
    33	        $media = $this->mediaRepository->findById(MediaId::fromString($query->mediaId));
    34	
    35	        if ($media === null) {
    36	            return null;
    37	        }
    38	
    39	        return $this->mediaUrlService->getOriginalUrl(
    40	            media: $media,
    41	            presignedTtlSeconds: $query->presignedTtlSeconds,
    42	        );
    43	    }
    44	}
