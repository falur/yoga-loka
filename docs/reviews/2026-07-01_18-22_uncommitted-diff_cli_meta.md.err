    86	    protected function persistReadyOriginalRemovedMedia(): Media
    87	    {
    88	        $media = $this->createMedia(MediaVisibility::Public);
    89	        $media->markUploaded();
    90	        $media->markReadyMovedTo(
    91	            MediaStorage::Public,
    92	            MediaPath::originalReady(storageKey: $media->storageKey, type: MediaType::Image, extension: 'jpg'),
    93	        );
    94	        $media->markReadyOriginalRemoved();
    95	        $this->persist($media);
    96	
    97	        return $media;
    98	    }
    99	
   100	    protected function profileHandlerAssembler(): UserPublicProfileAssembler
   101	    {
   102	        $fileService = $this->createStub(MediaFileServiceContract::class);
   103	        $fileService->method('publicUrl')->willReturn(self::STUBBED_AVATAR_URL);
   104	
   105	        return new UserPublicProfileAssembler(
   106	            queryBus: $this->getContainer()->get(QueryBusInterface::class),
   107	            findMediaOriginalUrlHandler: new FindMediaOriginalUrlHandler(
   108	                mediaRepository: $this->getContainer()->get(MediaRepository::class),
   109	                mediaUrlService: new MediaUrlService(
   110	                    mediaFileService: $fileService,
   111	                    mediaConfig: $this->getContainer()->get(MediaConfig::class),
   112	                ),
   113	            ),
   114	            defaultAvatarUrl: $this->getContainer()->get(UserConfig::class)->defaultAvatarUrl,
   115	        );
   116	    }
   117	
   118	    protected function defaultAvatarUrl(): string
   119	    {
   120	        return $this->getContainer()->get(UserConfig::class)->defaultAvatarUrl;
   121	    }
   122	
   123	    protected function userRepository(): UserRepository
   124	    {
   125	        return $this->getContainer()->get(UserRepository::class);
   126	    }
   127	
   128	    protected function persist(object $entity): void
   129	    {
   130	        $this->entityManager()->persist($entity);
   131	        $this->entityManager()->run();
   132	    }
   133	
   134	    protected function entityManager(): EntityManagerInterface
   135	    {
   136	        return $this->getContainer()->get(EntityManagerInterface::class);
   137	    }
   138	
   139	    private function createMedia(MediaVisibility $visibility): Media
   140	    {
   141	        $storageKey = MediaStorageKey::generate();
   142	
   143	        return Media::create(
   144	            storageKey: $storageKey,
   145	            type: MediaType::Image,
   146	            visibility: $visibility,
   147	            path: MediaPath::originalUpload(storageKey: $storageKey, extension: 'jpg'),
   148	            mimeType: MediaMimeType::fromString('image/jpeg'),
   149	            size: MediaFileSize::fromInt(1024),
   150	            uploadedById: UserId::generate(),
   151	            expiration: MediaExpiration::temporaryUntil(new \DateTimeImmutable('+1 hour')),
   152	        );
   153	    }
   154	}
