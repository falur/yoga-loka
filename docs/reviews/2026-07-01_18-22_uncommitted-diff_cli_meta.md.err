     3	declare(strict_types=1);
     4	
     5	namespace App\Modules\Media\Infrastructure\FileService;
     6	
     7	use App\Modules\Media\Application\Contract\MediaUploadPlannerContract;
     8	use App\Modules\Media\Domain\ValueObject\MediaExpiration;
     9	use App\Modules\Media\Domain\ValueObject\MediaFileSize;
    10	use App\Modules\Media\Domain\ValueObject\MediaMultipartPartSize;
    11	use App\Modules\Media\Domain\ValueObject\MediaMultipartPartsCount;
    12	use App\Shared\Infrastructure\Configuration\Media\MediaConfig;
    13	
    14	/**
    15	 * Считает решения пайплайна загрузки из MediaConfig: срок staging-хранения, порог multipart, размер и
    16	 * число частей. Лежит в Infrastructure и читает MediaConfig напрямую через конструктор (как
    17	 * MediaUrlService), биндится const BINDINGS в MediaBootloader. Срок staging считается на момент вызова
    18	 * внутри stagingExpiration(), иначе все загрузки получили бы один замороженный момент.
    19	 *
    20	 * partsCount() делит размер на переданный partSize->value(): вызывающий получает partSize() и отдаёт
    21	 * его же в partsCount(), поэтому деление всегда идёт на тот размер части, который записывается в
    22	 * MediaMultipartUpload (валидированный VO MediaMultipartPartSize, минимум 5 MiB). Согласованность пары
    23	 * partSize/partsCount держится сигнатурой, а не только докблоком.
    24	 */
    25	final readonly class MediaUploadPlanner implements MediaUploadPlannerContract
    26	{
    27	    public function __construct(
    28	        private MediaConfig $mediaConfig,
    29	    ) {}
    30	
    31	    public function stagingExpiration(): MediaExpiration
    32	    {
    33	        $expiresAt = new \DateTimeImmutable()->add(
    34	            new \DateInterval(\sprintf('PT%dS', $this->mediaConfig->stagingTtlSeconds)),
    35	        );
    36	
    37	        return MediaExpiration::temporaryUntil($expiresAt);
    38	    }
    39	
    40	    public function isMultipart(MediaFileSize $size): bool
    41	    {
    42	        return $size->value() >= $this->mediaConfig->multipartThresholdBytes;
    43	    }
    44	
    45	    public function partSize(): MediaMultipartPartSize
    46	    {
    47	        return MediaMultipartPartSize::fromInt($this->mediaConfig->multipartPartSizeBytes);
    48	    }
    49	
    50	    public function partsCount(MediaFileSize $size, MediaMultipartPartSize $partSize): MediaMultipartPartsCount
    51	    {
    52	        return MediaMultipartPartsCount::fromInt((int) \ceil($size->value() / $partSize->value()));
    53	    }
    54	}
