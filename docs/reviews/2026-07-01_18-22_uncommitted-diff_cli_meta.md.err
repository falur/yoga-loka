    40	     * чтобы вызывающий мог сгруппировать вложения по записи.
    41	     */
    42	    public function findByPostIds(PostId ...$postIds): PostMediaCollection
    43	    {
    44	        if ($postIds === []) {
    45	            return new PostMediaCollection();
    46	        }
    47	
    48	        return new PostMediaCollection(
    49	            $this->select()
    50	                ->where('post_id', 'in', new Parameter(\array_map(
