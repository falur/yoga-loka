     1	<?php
     2	
     3	declare(strict_types=1);
     4	
     5	namespace App\Modules\Media\Application\Command\DeleteMedia;
     6	
     7	use App\Modules\Media\Application\Contract\MediaFileServiceContract;
     8	use App\Modules\Media\Domain\Entity\Media;
     9	use App\Modules\Media\Domain\Enum\MediaStatus;
    10	use App\Modules\Media\Domain\ValueObject\MediaId;
    11	use App\Modules\Media\Repository\MediaAudioConversionRepository;
    12	use App\Modules\Media\Repository\MediaImageConversionRepository;
    13	use App\Modules\Media\Repository\MediaMultipartUploadRepository;
    14	use App\Modules\Media\Repository\MediaRepository;
    15	use App\Modules\Media\Repository\MediaVideoConversionRepository;
    16	use App\Shared\Domain\Exception\ForbiddenException;
    17	use App\Shared\Domain\Exception\NotFoundException;
    18	use App\Shared\Domain\ValueObject\UserId;
    19	use Cycle\ORM\EntityManagerInterface;
    20	use GianTiaga\SpiralCqrs\Attribute\LogOperation;
    21	use Psr\Log\LoggerInterface;
    22	
    23	final readonly class DeleteMediaHandler
    24	{
    25	    public function __construct(
    26	        private MediaRepository $mediaRepository,
    27	        private MediaMultipartUploadRepository $mediaMultipartUploadRepository,
    28	        private MediaImageConversionRepository $mediaImageConversionRepository,
    29	        private MediaVideoConversionRepository $mediaVideoConversionRepository,
    30	        private MediaAudioConversionRepository $mediaAudioConversionRepository,
    31	        private MediaFileServiceContract $mediaFileService,
    32	        private EntityManagerInterface $entityManager,
    33	        private LoggerInterface $logger,
    34	    ) {}
    35	
    36	    #[LogOperation]
    37	    public function handle(DeleteMediaCommand $command): void
    38	    {
    39	        $media = $this->mediaRepository->findById(MediaId::fromString($command->mediaId))
    40	            ?? throw new NotFoundException('app.media.not_found');
    41	
    42	        if (!$media->uploadedById->equals(UserId::fromString($command->userId))) {
    43	            throw new ForbiddenException('app.media.access_denied');
    44	        }
    45	
    46	        if ($media->status === MediaStatus::WaitingUpload) {
    47	            $this->abortActiveMultipartUpload($media);
    48	        }
    49	
    50	        // Объекты конверсий лежат в целевом бакете и каскадно удаляются из БД, но не из S3 —
    51	        // удаляем их явно до delete(), иначе остаются осиротевшие файлы. 404 игнорируется сервисом.
    52	        $this->deleteConversionObjects($media);
    53	
    54	        // Удаляем текущий оригинал (staging или целевой бакет). 404 игнорируется сервисом.
    55	        $this->mediaFileService->deleteObject(storage: $media->storage, path: $media->path);
    56	
    57	        $this->entityManager->delete($media);
    58	        $this->entityManager->run();
    59	
    60	        $this->logger->debug(message: 'Медиа удалено.', context: [
    61	            'mediaId' => $command->mediaId,
    62	            'userId' => $command->userId,
    63	        ]);
    64	    }
    65	
    66	    private function deleteConversionObjects(Media $media): void
    67	    {
    68	        foreach ($this->mediaImageConversionRepository->findByMediaId($media->id) as $imageConversion) {
    69	            $this->mediaFileService->deleteObject(storage: $imageConversion->storage, path: $imageConversion->path);
    70	        }
    71	
    72	        foreach ($this->mediaVideoConversionRepository->findByMediaId($media->id) as $videoConversion) {
    73	            $this->mediaFileService->deleteObject(storage: $videoConversion->storage, path: $videoConversion->path);
    74	        }
    75	
    76	        // Постер видео — это MediaImageConversion (Poster), он уже попадёт в image-цикл выше;
    77	        // здесь чистим только аудио-конверсии, чтобы не задваивать постер.
    78	        foreach ($this->mediaAudioConversionRepository->findByMediaId($media->id) as $audioConversion) {
    79	            $this->mediaFileService->deleteObject(storage: $audioConversion->storage, path: $audioConversion->path);
    80	        }
    81	    }
    82	
    83	    private function abortActiveMultipartUpload(Media $media): void
    84	    {
    85	        $multipartUpload = $this->mediaMultipartUploadRepository->findByMediaId($media->id);
    86	
    87	        if ($multipartUpload === null) {
    88	            return;
    89	        }
    90	
    91	        $this->mediaFileService->abortMultipartUpload(
    92	            storage: $media->storage,
    93	            path: $media->path,
    94	            uploadId: $multipartUpload->uploadId,
    95	        );
    96	    }
    97	}

