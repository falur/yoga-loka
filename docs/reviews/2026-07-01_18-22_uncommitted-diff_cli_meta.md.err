    48	
    49	    public function testFallsBackToDefaultWhenAvatarOriginalRemoved(): void
    50	    {
    51	        // Смысловой центр changeset на границе аватара: оригинал удалён -> getOriginalUrl = null ->
    52	        // ассемблер отдаёт аватар по умолчанию. Регресс-гард на случай, если оригинал снова начнёт
    53	        // отдавать (устаревшую) ссылку для readyOriginalRemoved.
    54	        $media = $this->persistReadyOriginalRemovedMedia();
    55	        $user = $this->persistUser(avatar: UserAvatar::pointingTo($media->id->value()));
    56	
    57	        $view = $this->handler()->handle(new GetUserPublicProfileQuery($user->id->value()));
