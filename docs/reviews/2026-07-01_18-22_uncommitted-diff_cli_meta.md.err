    20	use GianTiaga\SpiralCqrs\Attribute\LogOperation;
    21	use Psr\Log\LoggerInterface;
    22	
    23	final readonly class RequestMediaUploadHandler
    24	{
    25	    public function __construct(
    26	        private MediaFileServiceContract $mediaFileService,
    27	        private MediaTypeResolver $mediaTypeResolver,
    28	        private MediaUploadPlannerContract $uploadPlanner,
    29	        private EntityManagerInterface $entityManager,
    30	        private LoggerInterface $logger,
    31	    ) {}
    32	
    33	    #[LogOperation]
    34	    public function handle(RequestMediaUploadCommand $command): RequestMediaUploadResult
    35	    {
    36	        $mediaType = $this->mediaTypeResolver->resolve($command->fileMeta->mimeType);
    37	        $this->assertUploadAllowed(spec: $command->spec, fileMeta: $command->fileMeta);
    38	
    39	        $storageKey = MediaStorageKey::generate();
    40	        $media = Media::create(
    41	            storageKey: $storageKey,
    42	            type: $mediaType,
    43	            visibility: $command->spec->visibility,
    44	            path: MediaPath::originalUpload(storageKey: $storageKey, extension: $this->extension($command->fileMeta)),
    45	            mimeType: $command->fileMeta->mimeType,
    46	            size: $command->fileMeta->size,
    47	            uploadedById: UserId::fromString($command->userId),
    48	            expiration: $this->uploadPlanner->stagingExpiration(),
    49	        );
    50	
    51	        $presignedExpiresAt = $this->expiresIn($command->spec->presignedTtl->value());
    52	        $preparedUpload = $this->uploadPlanner->isMultipart($command->fileMeta->size)
    53	            ? $this->prepareMultipartUpload(media: $media, presignedExpiresAt: $presignedExpiresAt)
    54	            : $this->prepareSingleUpload(media: $media, presignedExpiresAt: $presignedExpiresAt);
    55	
    56	        $this->entityManager->run();
    57	
    58	        $this->logger->debug(message: 'Запрошена загрузка медиа.', context: [
    59	            'mediaId' => $media->id->value(),
    60	            'userId' => $command->userId,
    61	            'uploadMode' => $preparedUpload->uploadMode->value,
    62	            'size' => $command->fileMeta->size->value(),
    63	            'mimeType' => $command->fileMeta->mimeType->value(),
    64	            'presignedTtlSeconds' => $command->spec->presignedTtl->value(),
    65	        ]);
    66	
    67	        return $preparedUpload;
    68	    }
    69	
    70	    private function prepareSingleUpload(Media $media, \DateTimeImmutable $presignedExpiresAt): RequestMediaUploadResult
    71	    {
    72	        $putUrl = $this->mediaFileService->presignPut(
    73	            storage: $media->storage,
    74	            path: $media->path,
    75	            mimeType: $media->mimeType,
    76	            expiresAt: $presignedExpiresAt,
    77	        );
    78	        $this->entityManager->persist($media);
    79	
    80	        return RequestMediaUploadResult::single(
    81	            mediaId: $media->id->value(),
    82	            putUrl: $putUrl,
    83	            expiresAt: $presignedExpiresAt,
    84	        );
    85	    }
    86	
    87	    private function prepareMultipartUpload(Media $media, \DateTimeImmutable $presignedExpiresAt): RequestMediaUploadResult
    88	    {
    89	        $partSize = $this->uploadPlanner->partSize();
    90	        $partsCount = $this->uploadPlanner->partsCount(size: $media->size, partSize: $partSize);
    91	        $uploadId = $this->mediaFileService->createMultipartUpload(
    92	            storage: $media->storage,
    93	            path: $media->path,
    94	            mimeType: $media->mimeType,
    95	        );
    96	        $parts = $this->mediaFileService->presignUploadParts(
    97	            storage: $media->storage,
    98	            path: $media->path,
    99	            uploadId: $uploadId,
   100	            partsCount: $partsCount,
   101	            expiresAt: $presignedExpiresAt,
   102	        );
   103	
   104	        $this->entityManager->persist($media);
   105	        $this->entityManager->persist(MediaMultipartUpload::create(
   106	            media: $media,
   107	            uploadId: $uploadId,
   108	            partsCount: $partsCount,
   109	            partSize: $partSize,
   110	            fileSize: $media->size,
   111	        ));
   112	
   113	        return RequestMediaUploadResult::multipart(
   114	            mediaId: $media->id->value(),
   115	            uploadId: $uploadId->value(),
   116	            parts: $parts,
   117	            expiresAt: $presignedExpiresAt,
   118	        );
   119	    }
   120	
   121	    private function assertUploadAllowed(MediaUploadSpec $spec, MediaFileMeta $fileMeta): void
   122	    {
   123	        if (!$spec->allowedMimeTypes->containsMimeType($fileMeta->mimeType)) {
   124	            throw new ValidationException(
   125	                translationKey: 'app.media.mime_not_allowed',
   126	                translationParameters: ['mimeType' => $fileMeta->mimeType->value()],
   127	            );
   128	        }
   129	
   130	        if ($fileMeta->size->value() > $spec->maxSize->value()) {
   131	            throw new ValidationException('app.media.file_size_exceeded');
   132	        }
   133	    }
   134	
   135	    private function extension(MediaFileMeta $fileMeta): string
   136	    {
   137	        $extension = \pathinfo(path: $fileMeta->fileName, flags: \PATHINFO_EXTENSION);
   138	
   139	        if ($extension === '') {
   140	            throw new ValidationException('app.media.file_name_without_extension');
   141	        }
   142	
   143	        return $extension;
   144	    }
   145	
   146	    private function expiresIn(int $seconds): \DateTimeImmutable
   147	    {
   148	        return new \DateTimeImmutable()->add(new \DateInterval(\sprintf('PT%dS', $seconds)));
   149	    }
   150	}
     1	<?php
     2	
     3	declare(strict_types=1);
     4	
     5	namespace App\Modules\Media\Application\Command\ProcessMedia;
     6	
     7	use App\Modules\Media\Application\Contract\MediaAudioProcessorContract;
     8	use App\Modules\Media\Application\Contract\MediaFileServiceContract;
     9	use App\Modules\Media\Application\Contract\MediaImageProcessorContract;
    10	use App\Modules\Media\Application\Contract\MediaVideoProcessorContract;
    11	use App\Modules\Media\Application\Dto\MediaConversionPlan;
    12	use App\Modules\Media\Domain\Entity\Media;
    13	use App\Modules\Media\Domain\Entity\MediaAudioConversion;
    14	use App\Modules\Media\Domain\Entity\MediaImageConversion;
    15	use App\Modules\Media\Domain\Entity\MediaVideoConversion;
    16	use App\Modules\Media\Domain\Enum\MediaConversionStatus;
    17	use App\Modules\Media\Domain\Enum\MediaImageConversionType;
    18	use App\Modules\Media\Domain\Enum\MediaStorage;
    19	use App\Modules\Media\Domain\Enum\MediaType;
    20	use App\Modules\Media\Domain\Enum\MediaVisibility;
    21	use App\Modules\Media\Domain\ValueObject\MediaId;
    22	use App\Modules\Media\Domain\ValueObject\MediaPath;
    23	use App\Modules\Media\Domain\ValueObject\MediaPixelDimension;
    24	use App\Modules\Media\Repository\MediaRepository;
    25	use App\Shared\Domain\Exception\NotFoundException;
    26	use Cycle\ORM\EntityManagerInterface;
    27	use GianTiaga\SpiralCqrs\Attribute\LogOperation;
    28	use Illuminate\Support\Collection;
    29	use Psr\Log\LoggerInterface;
    30	
    31	/**
    32	 * Без #[Transactional]: все S3/ffmpeg/Imagick-операции выполняются вне транзакции, затем один
    33	 * атомарный persist+run() с переходом в ready. Идемпотентен: на ready — no-op; конверсии
    34	 * создаются только в финальном flush, поэтому частичного состояния не бывает и повтор
    35	 * пересоздаёт их без конфликта по unique (media_id, type) (процессоры перезаписывают объекты
    36	 * по детерминированным путям).
    37	 */
    38	final readonly class ProcessMediaHandler
    39	{
    40	    public function __construct(
    41	        private MediaRepository $mediaRepository,
    42	        private MediaFileServiceContract $mediaFileService,
    43	        private MediaImageProcessorContract $mediaImageProcessor,
    44	        private MediaVideoProcessorContract $mediaVideoProcessor,
    45	        private MediaAudioProcessorContract $mediaAudioProcessor,
    46	        private EntityManagerInterface $entityManager,
    47	        private LoggerInterface $logger,
    48	    ) {}
    49	
    50	    #[LogOperation]
    51	    public function handle(ProcessMediaCommand $command): void
    52	    {
    53	        $media = $this->mediaRepository->findById(MediaId::fromString($command->mediaId))
    54	            ?? throw new NotFoundException('app.media.not_found');
    55	
    56	        if ($media->isFinalized()) {
    57	            $this->logger->debug(message: 'Обработка медиа пропущена: медиа уже финализировано.', context: [
    58	                'mediaId' => $media->id->value(),
    59	            ]);
    60	
    61	            return;
    62	        }
    63	
    64	        $this->logger->debug(message: 'Начата обработка медиа.', context: [
    65	            'mediaId' => $media->id->value(),
    66	            'type' => $media->type->value,
    67	        ]);
    68	
    69	        $targetStorage = $this->targetStorage($media->visibility);
    70	        $extension = $media->path->extension();
    71	
    72	        $conversions = match ($media->type) {
    73	            MediaType::Image => $this->buildImageConversions(
    74	                media: $media,
    75	                plan: $command->plan,
    76	                targetStorage: $targetStorage,
    77	                extension: $extension,
    78	            ),
    79	            MediaType::Video => $this->buildVideoConversions(
    80	                media: $media,
    81	                plan: $command->plan,
    82	                targetStorage: $targetStorage,
    83	            ),
    84	            MediaType::Audio => $this->buildAudioConversions(
    85	                media: $media,
    86	                plan: $command->plan,
    87	                targetStorage: $targetStorage,
    88	            ),
    89	            MediaType::Document => [],
    90	        };
    91	
    92	        $this->persistReady(
    93	            media: $media,
    94	            conversions: $conversions,
    95	            targetStorage: $targetStorage,
    96	            extension: $extension,
    97	        );
    98	    }
    99	
   100	    /**
   101	     * @param list<MediaImageConversion|MediaVideoConversion|MediaAudioConversion> $conversions
   102	     */
   103	    private function persistReady(
   104	        Media $media,
   105	        array $conversions,
   106	        MediaStorage $targetStorage,
   107	        string $extension,
   108	    ): void {
   109	        $targetPath = MediaPath::originalReady(storageKey: $media->storageKey, type: $media->type, extension: $extension);
   110	        $this->mediaFileService->copyObject(
   111	            fromStorage: $media->storage,
   112	            fromPath: $media->path,
   113	            toStorage: $targetStorage,
   114	            toPath: $targetPath,
   115	        );
   116	        $media->markReadyMovedTo(storage: $targetStorage, path: $targetPath);
   117	
   118	        $this->entityManager->persist($media);
   119	        foreach ($conversions as $conversion) {
   120	            $this->entityManager->persist($conversion);
   121	        }
   122	        $this->entityManager->run();
   123	
   124	        $this->logger->debug(message: 'Медиа готово.', context: [
   125	            'mediaId' => $media->id->value(),
   126	            'targetStorage' => $targetStorage->value,
   127	            'imageConversions' => $this->countByClass(conversions: $conversions, conversionClass: MediaImageConversion::class),
   128	            'videoConversions' => $this->countByClass(conversions: $conversions, conversionClass: MediaVideoConversion::class),
   129	            'audioConversions' => $this->countByClass(conversions: $conversions, conversionClass: MediaAudioConversion::class),
   130	        ]);
   131	    }
   132	
   133	    /**
   134	     * @param list<MediaImageConversion|MediaVideoConversion|MediaAudioConversion> $conversions
   135	     * @param class-string $conversionClass
   136	     */
   137	    private function countByClass(array $conversions, string $conversionClass): int
   138	    {
   139	        return Collection::make($conversions)
   140	            ->filter(static fn(MediaImageConversion|MediaVideoConversion|MediaAudioConversion $conversion): bool
   141	                => $conversion instanceof $conversionClass)
   142	            ->count();
   143	    }
   144	
   145	    /**
   146	     * @return list<MediaImageConversion>
   147	     */
   148	    private function buildImageConversions(
   149	        Media $media,
   150	        MediaConversionPlan $plan,
   151	        MediaStorage $targetStorage,
   152	        string $extension,
   153	    ): array {
   154	        if ($plan->image === []) {
   155	            return [];
   156	        }
   157	
   158	        $originalContents = $this->mediaFileService->getObjectContents(storage: $media->storage, path: $media->path);
   159	
   160	        $conversions = [];
   161	
   162	        foreach ($plan->image as $spec) {
   163	            $conversionResult = $this->mediaImageProcessor->resize(
   164	                originalContents: $originalContents,
   165	                width: MediaPixelDimension::fromInt($spec->width),
   166	                height: MediaPixelDimension::fromInt($spec->height),
   167	                targetMimeType: $media->mimeType,
   168	            );
   169	            $conversionPath = MediaPath::imageConversion(
   170	                storageKey: $media->storageKey,
   171	                type: $spec->type,
   172	                extension: $extension,
   173	            );
   174	            $this->mediaFileService->putObject(
   175	                storage: $targetStorage,
   176	                path: $conversionPath,
   177	                contents: $conversionResult->contents,
   178	                mimeType: $conversionResult->mimeType,
   179	            );
   180	
   181	            $this->logger->debug(message: 'Создана конверсия изображения.', context: [
   182	                'type' => $spec->type->value,
   183	                'path' => $conversionPath->value(),
   184	                'size' => $conversionResult->size->value(),
   185	            ]);
   186	
   187	            // width/height берём из результата процессора (размер реально записанного объекта),
   188	            // а не из spec — устойчиво к смене режима ресайза. См. README.
   189	            $conversions[] = MediaImageConversion::create(
   190	                media: $media,
   191	                type: $spec->type,
   192	                status: MediaConversionStatus::Ready,
   193	                storage: $targetStorage,
   194	                path: $conversionPath,
   195	                mimeType: $conversionResult->mimeType,
   196	                size: $conversionResult->size,
   197	                width: $conversionResult->width,
   198	                height: $conversionResult->height,
   199	            );
   200	        }
   201	
   202	        return $conversions;
   203	    }
   204	
   205	    /**
   206	     * @return list<MediaVideoConversion|MediaImageConversion>
   207	     */
   208	    private function buildVideoConversions(
   209	        Media $media,
   210	        MediaConversionPlan $plan,
   211	        MediaStorage $targetStorage,
   212	    ): array {
   213	        $conversions = [];
   214	
   215	        foreach ($plan->video as $spec) {
   216	            $normalizedPath = MediaPath::videoConversion(storageKey: $media->storageKey, type: $spec->type, extension: 'mp4');
   217	            $posterPath = MediaPath::imageConversion(
   218	                storageKey: $media->storageKey,
   219	                type: MediaImageConversionType::Poster,
   220	                extension: 'jpg',
   221	            );
   222	
   223	            $result = $this->mediaVideoProcessor->process(
   224	                sourceStorage: $media->storage,
   225	                sourcePath: $media->path,
   226	                spec: $spec,
   227	                targetStorage: $targetStorage,
   228	                normalizedPath: $normalizedPath,
   229	                posterPath: $posterPath,
   230	            );
   231	
   232	            $conversions[] = MediaVideoConversion::create(
   233	                media: $media,
   234	                type: $spec->type,
   235	                status: MediaConversionStatus::Ready,
   236	                storage: $targetStorage,
   237	                path: $normalizedPath,
   238	                mimeType: $result->normalizedMimeType,
   239	                size: $result->normalizedSize,
   240	                width: $result->width,
   241	                height: $result->height,
   242	                duration: $result->duration,
   243	                bitrate: $result->bitrate,
   244	            );
   245	            // Постер видео — MediaImageConversion type=Poster размером транскода (width/height).
   246	            $conversions[] = MediaImageConversion::create(
   247	                media: $media,
   248	                type: MediaImageConversionType::Poster,
   249	                status: MediaConversionStatus::Ready,
   250	                storage: $targetStorage,
   251	                path: $posterPath,
   252	                mimeType: $result->posterMimeType,
   253	                size: $result->posterSize,
   254	                width: $result->width,
   255	                height: $result->height,
   256	            );
   257	
   258	            $this->logger->debug(message: 'Создана конверсия видео и постер.', context: [
   259	                'type' => $spec->type->value,
   260	                'path' => $normalizedPath->value(),
   261	                'size' => $result->normalizedSize->value(),
   262	            ]);
   263	        }
   264	
   265	        return $conversions;
   266	    }
   267	
   268	    /**
   269	     * @return list<MediaAudioConversion>
   270	     */
   271	    private function buildAudioConversions(
