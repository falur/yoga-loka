   294	                path: $normalizedPath,
   295	                mimeType: $result->normalizedMimeType,
   296	                size: $result->normalizedSize,
   297	                duration: $result->duration,
   298	                bitrate: $result->bitrate,
   299	                sampleRate: $result->sampleRate,
   300	                waveform: $result->waveform,

