   324	        $media = $this->readyMediaWithoutConversions(
   325	            userId: $userId,
   326	            type: MediaType::Audio,
   327	            extension: 'mp3',
   328	            mimeType: 'audio/mpeg',
   329	        );
   330	
   331	        $this->persist($this->audioConversion($media));
   332	
   333	        return $media;
   334	    }
   335	
   336	    private function readyMediaWithoutConversions(
   337	        UserId $userId,
   338	        MediaType $type,
   339	        string $extension,
   340	        string $mimeType,
   341	    ): Media {
   342	        $media = $this->createMedia(
   343	            userId: $userId,
   344	            visibility: MediaVisibility::Public,
   345	            type: $type,
   346	            extension: $extension,
   347	            mimeType: $mimeType,
   348	        );
   349	        $media->markUploaded();
   350	        $media->markReadyMovedTo(
   351	            MediaStorage::Public,
   352	            MediaPath::originalReady(storageKey: $media->storageKey, type: $type, extension: $extension),
   353	        );
   354	        $this->persist($media);
   355	
   356	        return $media;
   357	    }
   358	}

