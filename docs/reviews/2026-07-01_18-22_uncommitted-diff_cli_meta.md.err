    47	final readonly class MediaUrlService implements MediaUrlServiceContract
    48	{
    49	    public function __construct(
    50	        private MediaFileServiceContract $mediaFileService,
    51	        private MediaConfig $mediaConfig,
    52	    ) {}
    53	
    54	    public function getUrls(Media $media, int|null $presignedTtlSeconds = null): MediaUrlsResult|null
    55	    {
    56	        if (!$media->isFinalized()) {
    57	            return null;
    58	        }
    59	
    60	        $resolver = $this->resolverFor(
    61	            visibility: $media->visibility,
    62	            presignedTtlSeconds: $presignedTtlSeconds,
    63	        );
    64	
    65	        return new MediaUrlsResult(
    66	            original: $media->isReady() ? $resolver->resolve(storage: $media->storage, path: $media->path) : null,
