   111	                ->configureWith(new ConvertKeysToCamelCase())
   112	                ->allowPermissiveTypes()
   113	                ->allowScalarValueCasting()
   114	                ->mapper(),
   115	            normalizer: new NormalizerBuilder()->normalizer(Format::array()),
   116	        );
   117	    }
