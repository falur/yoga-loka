    10	
    11	final class AppBootloaderTest extends TestCase
    12	{
    13	    public function testLocaleResolverIsBuiltFromConfig(): void
    14	    {
    15	        $localeConfig = $this->getContainer()->get(LocaleConfig::class);
    16	        $localeResolver = $this->getContainer()->get(LocaleResolver::class);
    17	
    18	        self::assertInstanceOf(LocaleResolver::class, $localeResolver);
    19	        // Резолвер собран именно из LocaleConfig фабрикой бутлоадера: неподдерживаемая локаль сводится
    20	        // к фактическому значению по умолчанию из конфига (а не к произвольной из supported)...
    21	        self::assertSame($localeConfig->default, $localeResolver->resolve('zz'));
    22	        // ...а каждая поддерживаемая локаль возвращается как есть.
    23	        foreach ($localeConfig->supported as $supported) {
    24	            self::assertSame($supported, $localeResolver->resolve($supported));
    25	        }
    26	    }
    27	}

