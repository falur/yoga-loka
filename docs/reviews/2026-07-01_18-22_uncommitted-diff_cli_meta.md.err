    68	        );
    69	    }
    70	
    71	    /**
    72	     * Только ссылка на оригинал, без обращения к связям-конверсиям. Возвращает null, если оригинала
    73	     * нет (медиа не финализировано или оригинал удалён в readyOriginalRemoved) — вызывающий подставит
    74	     * значение по умолчанию. Не трогает imageConversions/videoConversions/audioConversions, поэтому
    75	     * не подгружает их из БД и не подписывает presigned-ссылки для конверсий, которые потребителю
    76	     * (аватар, лента) не нужны.
    77	     */
    78	    public function getOriginalUrl(Media $media, int|null $presignedTtlSeconds = null): MediaUrlResult|null
    79	    {
    80	        if (!$media->isReady()) {
    81	            return null;
    82	        }
    83	
    84	        $resolver = $this->resolverFor(
    85	            visibility: $media->visibility,
    86	            presignedTtlSeconds: $presignedTtlSeconds,
    87	        );
    88	
    89	        return $resolver->resolve(storage: $media->storage, path: $media->path);
    90	    }
    91	
    92	    /**
    93	     * Резолвер URL по контексту медиа: public — прямые URL без срока (TTL не нужен и не валидируется),
    94	     * private — presigned с единым сроком на весь набор URL одного вызова. Ветвление — исчерпывающий
    95	     * match по MediaVisibility без default: новый вариант видимости не уйдёт молча в приватную ветку,
    96	     * а будет пойман статическим анализом.
    97	     */
    98	    private function resolverFor(MediaVisibility $visibility, int|null $presignedTtlSeconds): MediaUrlResolver
    99	    {
   100	        return match ($visibility) {
   101	            MediaVisibility::Public => new PublicMediaUrlResolver($this->mediaFileService),
   102	            MediaVisibility::Private => $this->presignedResolverFor($presignedTtlSeconds),
   103	        };
   104	    }
   105	
   106	    /**
   107	     * Presigned-резолвер с единым сроком на весь набор URL одного вызова. Переопределение TTL строго
   108	     * по `?? `: null -> значение по умолчанию из конфига; явный 0 или значение вне диапазона ->
   109	     * исключение MediaPresignedTtl (нельзя писать `?:`, иначе явный 0 тихо ушёл бы в значение по
   110	     * умолчанию).
   111	     */
   112	    private function presignedResolverFor(int|null $presignedTtlSeconds): PresignedMediaUrlResolver
   113	    {
   114	        $ttl = MediaPresignedTtl::fromInt($presignedTtlSeconds ?? $this->mediaConfig->presignedTtlSeconds);
   115	        $expiresAt = new \DateTimeImmutable()->add(new \DateInterval(\sprintf('PT%dS', $ttl->value())));
   116	
   117	        return new PresignedMediaUrlResolver(mediaFileService: $this->mediaFileService, expiresAt: $expiresAt);
   118	    }
   119	
   120	    private function conversionUrls(Media $media, MediaUrlResolver $resolver): MediaConversionUrlCollection
   121	    {
   122	        $imageUrls = $this->conversionUrlsOf(
   123	            conversions: $media->imageConversions->toBase(),
   124	            kind: MediaConversionKind::Image,
   125	            resolver: $resolver,
   126	        );
   127	        $videoUrls = $this->conversionUrlsOf(
   128	            conversions: $media->videoConversions->toBase(),
   129	            kind: MediaConversionKind::Video,
   130	            resolver: $resolver,
   131	        );
   132	        $audioUrls = $this->conversionUrlsOf(
   133	            conversions: $media->audioConversions->toBase(),
   134	            kind: MediaConversionKind::Audio,
   135	            resolver: $resolver,
   136	        );
   137	
   138	        return new MediaConversionUrlCollection($imageUrls->concat($videoUrls)->concat($audioUrls));
   139	    }
   140	
   141	    /**
   142	     * Строит ссылки конверсий одного вида. Обвязка filter+map одинакова для image/video/audio и
   143	     * различается только видом и типом элемента, поэтому вынесена сюда (раньше — три почти одинаковых
   144	     * map-блока). Не-Ready конверсии (processing/processingFailed) отсеиваются: URL отдаётся только для
   145	     * готовых, чтобы потребитель не получил ссылку на ещё не готовый объект.
   146	     *
   147	     * После filter ключи переиндексируются через ->values(): если отсеялась не последняя конверсия,
   148	     * остаток сохранил бы исходные ключи с разрывом, и итоговый набор сериализовался бы как JSON-объект
   149	     * (`{"1": …}`), а не как массив. Переиндексация держит коллекцию списком с ключами от нуля.
   150	     *
   151	     * @param Collection<int, MediaImageConversion|MediaVideoConversion|MediaAudioConversion> $conversions
   152	     * @return Collection<int, MediaConversionUrl>
   153	     */
   154	    private function conversionUrlsOf(
   155	        Collection $conversions,
   156	        MediaConversionKind $kind,
   157	        MediaUrlResolver $resolver,
   158	    ): Collection {
   159	        return $conversions
   160	            ->filter(
   161	                static fn(MediaImageConversion|MediaVideoConversion|MediaAudioConversion $conversion): bool
   162	                    => $conversion->status === MediaConversionStatus::Ready,
   163	            )
   164	            ->map(
   165	                fn(MediaImageConversion|MediaVideoConversion|MediaAudioConversion $conversion): MediaConversionUrl
   166	                    => $this->conversionUrl(
   167	                        kind: $kind,
   168	                        type: $conversion->type,
   169	                        storage: $conversion->storage,
   170	                        path: $conversion->path,
   171	                        resolver: $resolver,
   172	                    ),
   173	            )
   174	            ->values();
   175	    }
   176	
   177	    private function conversionUrl(
   178	        MediaConversionKind $kind,
   179	        MediaImageConversionType|MediaVideoConversionType|MediaAudioConversionType $type,
   180	        MediaStorage $storage,
   181	        MediaPath $path,
   182	        MediaUrlResolver $resolver,
   183	    ): MediaConversionUrl {
   184	        $resolved = $resolver->resolve(storage: $storage, path: $path);
   185	
   186	        return new MediaConversionUrl(kind: $kind, type: $type, url: $resolved->url, expiresAt: $resolved->expiresAt);
   187	    }
   188	}

