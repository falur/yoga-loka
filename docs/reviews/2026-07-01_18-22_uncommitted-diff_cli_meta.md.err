    99	     * @param array<string, mixed> $config
   100	     */
   101	    private function mapperFor(array $config): ConfigMapper
   102	    {
   103	        $configurator = $this->createStub(ConfiguratorInterface::class);
   104	        $configurator
   105	            ->method('getConfig')
   106	            ->willReturnMap([[MediaConfig::configName(), $config]]);
