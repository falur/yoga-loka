     9	 * варианта document здесь нет (в отличие от MediaType): потребитель с исчерпывающим match по kind не
    10	 * тянет заведомо мёртвую ветку document. Постер видео имеет kind = image, т.к. это кадр-картинка.
    11	 */
    12	enum MediaConversionKind: string
    13	{
    14	    case Image = 'image';
    15	    case Video = 'video';
    16	    case Audio = 'audio';
