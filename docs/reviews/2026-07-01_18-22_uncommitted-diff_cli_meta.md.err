   298	        foreach ($tagCollections as $tags) {
   299	            foreach ($tags as $postTag) {
   300	                $tagIds[] = $postTag->tagId->value();
   301	            }
   302	        }
   303	
   304	        if ($tagIds === []) {
   305	            return new TagTextCollection();
   306	        }
   307	
   308	        return $this->queryBus->dispatch(
   309	            query: new GetTagsQuery(\array_values(\array_unique($tagIds))),
   310	            handler: $this->getTagsHandler->handle(...),
   311	        );
   312	    }
   313	
   314	    /**
   315	     * Строит представления тегов записи из общего батча текстов. В листинге батч содержит теги всех
   316	     * записей страницы, поэтому теги, не относящиеся к этой записи, отсеиваются по принадлежности.
   317	     * Принадлежность проверяется по заранее построенному множеству id связей записи за O(1) (вместо
   318	     * линейного поиска по связям на каждый элемент батча) — это убирает квадратичность на странице с
   319	     * тег-тяжёлыми записями. Порядок тегов в ответе определяется выборкой текстов из Tags и не
   320	     * является частью контракта (в post_tags нет колонки позиции — порядок добавления не хранится).
   321	     *
   322	     * @return list<TagView>
   323	     */
   324	    private function tagViews(PostTagCollection $tags, TagTextCollection $texts): array
   325	    {
   326	        $postTagIds = [];
   327	
   328	        foreach ($tags as $postTag) {
   329	            $postTagIds[$postTag->tagId->value()] = true;
   330	        }
   331	
   332	        $views = [];
   333	
   334	        foreach ($texts as $tagId => $text) {
   335	            if (!isset($postTagIds[$tagId])) {
   336	                continue;
   337	            }
   338	
   339	            $views[] = new TagView(id: $tagId, text: $text);
   340	        }
   341	
   342	        return $views;
   343	    }
