   176	
   177	    public function testExcludesNonReadyConversionsFromUrls(): void
   178	    {
   179	        // Среди связей есть готовая (Ready) image-конверсия и не-Ready (processing) video-конверсия.
   180	        // В набор URL попадает только готовая: не-Ready не отдаём, чтобы не дать ссылку на не готовый объект.
   181	        $media = $this->readyMedia(MediaVisibility::Public);
   182	        $thumbnail = $this->thumbnailConversion($media);
   183	        $processingVideo = $this->videoConversion(media: $media, status: MediaConversionStatus::Processing);
   184	        $this->persist($media, $thumbnail, $processingVideo);
   185	        $this->cleanOrmHeap();
   186	
   187	        $fileService = $this->createStub(MediaFileServiceContract::class);
   188	        $fileService->method('publicUrl')->willReturnCallback(
   189	            static fn(MediaStorage $storage, MediaPath $path): string => 'http://minio/media-public/' . $path->value(),
   190	        );
   191	
   192	        $result = $this->handler($fileService)->handle(
   193	            new FindMediaUrlQuery(mediaId: $media->id->value(), presignedTtlSeconds: 300),
   194	        );
   195	
   196	        self::assertNotNull($result);
   197	        self::assertCount(1, $result->conversions);
   198	        self::assertNotNull($result->conversions->ofType(MediaImageConversionType::Thumbnail));
   199	        self::assertNull($result->conversions->ofType(MediaVideoConversionType::NormalizedMp4H264));
   200	    }
   201	
   202	    public function testReindexesConversionsWhenNonReadyPrecedesReadyInSameKind(): void
   203	    {
   204	        // В рамках одного вида (image) первой по порядку (orderBy id ASC) идёт не-Ready (processing)
   205	        // конверсия, затем Ready. filter() отсеивает первую и без переиндексации оставил бы готовую на
   206	        // ключе 1 — коллекция стала бы картой с разрывом и сериализовалась как JSON-объект {"1": ...}.
   207	        // Проверяем, что итог переиндексирован в список и сериализуется как массив.
   208	        $media = $this->readyMedia(MediaVisibility::Public);
   209	        $processingThumbnail = $this->imageConversion(
   210	            media: $media,
   211	            type: MediaImageConversionType::Thumbnail,
   212	            status: MediaConversionStatus::Processing,
   213	        );
   214	        $readyPreview = $this->imageConversion(
   215	            media: $media,
   216	            type: MediaImageConversionType::Preview,
   217	            status: MediaConversionStatus::Ready,
   218	        );
   219	        $this->persist($media, $processingThumbnail, $readyPreview);
   220	        $this->cleanOrmHeap();
   221	
   222	        $fileService = $this->createStub(MediaFileServiceContract::class);
   223	        $fileService->method('publicUrl')->willReturnCallback(
   224	            static fn(MediaStorage $storage, MediaPath $path): string => 'http://minio/media-public/' . $path->value(),
   225	        );
   226	
   227	        $result = $this->handler($fileService)->handle(
   228	            new FindMediaUrlQuery(mediaId: $media->id->value(), presignedTtlSeconds: 300),
   229	        );
   230	
   231	        self::assertNotNull($result);
   232	
   233	        // Осталась только готовая конверсия, и она на нулевом ключе — список без разрыва.
   234	        self::assertCount(1, $result->conversions);
   235	        self::assertSame([0], $result->conversions->keys()->all());
   236	        self::assertNotNull($result->conversions->ofType(MediaImageConversionType::Preview));
   237	
   238	        // Главное: набор сериализуется как JSON-массив, а не как объект с разрывом ключей ({"1": ...}).
   239	        $encoded = \json_encode($result->conversions);
   240	        self::assertNotFalse($encoded);
   241	        self::assertStringStartsWith('[', $encoded);
   242	    }
   243	
   244	    public function testIgnoresInvalidTtlForPublicMedia(): void
   245	    {
   246	        // Для public-медиа ветка резолвера short-circuit'ит до построения MediaPresignedTtl, поэтому
   247	        // заведомо невалидный TTL (явный 0) проходит как успех без presignGet — причина именно в
   248	        // public short-circuit, а не в самом значении 0 (для private такой 0 бросил бы исключение).
   249	        $media = $this->readyMedia(MediaVisibility::Public);
   250	        $this->persist($media);
   251	        $this->cleanOrmHeap();
   252	
   253	        $fileService = $this->createMock(MediaFileServiceContract::class);
   254	        $fileService->expects(self::once())->method('publicUrl')->willReturn('http://minio/media-public/object');
   255	        $fileService->expects(self::never())->method('presignGet');
   256	
   257	        $result = $this->handler($fileService)->handle(
   258	            new FindMediaUrlQuery(mediaId: $media->id->value(), presignedTtlSeconds: 0),
   259	        );
   260	
   261	        self::assertNotNull($result);
   262	        self::assertNotNull($result->original);
   263	        self::assertSame('http://minio/media-public/object', $result->original->url);
   264	        self::assertNull($result->original->expiresAt);
   265	    }
   266	
   267	    public function testUsesDefaultTtlForPrivateMediaWithoutOverride(): void
   268	    {
   269	        // Без presignedTtlSeconds в запросе берётся значение по умолчанию сервиса (3600), а expiresAt
   270	        // считается на каждый вызов (singleton) — now + 3600.
   271	        $media = $this->readyMedia(MediaVisibility::Private);
   272	        $this->persist($media);
   273	        $this->cleanOrmHeap();
   274	
   275	        $fileService = $this->createStub(MediaFileServiceContract::class);
   276	        $fileService->method('presignGet')->willReturnCallback(
   277	            static fn(MediaStorage $storage, MediaPath $path, \DateTimeImmutable $expiresAt): string
   278	                => 'http://minio/signed/' . $path->value(),
   279	        );
   280	
   281	        $result = $this->handler($fileService)->handle(
   282	            new FindMediaUrlQuery(mediaId: $media->id->value()),
   283	        );
   284	
   285	        self::assertNotNull($result);
   286	        self::assertNotNull($result->original);
   287	        self::assertNotNull($result->original->expiresAt);
   288	        self::assertEqualsWithDelta(
   289	            new \DateTimeImmutable('+3600 seconds')->getTimestamp(),
   290	            $result->original->expiresAt->getTimestamp(),
   291	            5,
   292	        );
   293	    }
   294	
   295	    public function testRejectsExplicitZeroTtlForPrivateMedia(): void
   296	    {
   297	        // Строгая семантика !== null: явный 0 для private не уходит в значение по умолчанию, а строит
   298	        // MediaPresignedTtl::fromInt(0) -> вне диапазона (MIN=1) -> InvalidDomainValueException.
   299	        $media = $this->readyMedia(MediaVisibility::Private);
   300	        $this->persist($media);
   301	        $this->cleanOrmHeap();
   302	
   303	        $this->expectException(InvalidDomainValueException::class);
   304	
   305	        $this->handler($this->createStub(MediaFileServiceContract::class))->handle(
   306	            new FindMediaUrlQuery(mediaId: $media->id->value(), presignedTtlSeconds: 0),
   307	        );
   308	    }
   309	
   310	    private function handler(MediaFileServiceContract $fileService): FindMediaUrlHandler
   311	    {
   312	        return new FindMediaUrlHandler(
   313	            mediaRepository: $this->mediaRepository(),
   314	            mediaUrlService: new MediaUrlService(
   315	                mediaFileService: $fileService,
   316	                mediaConfig: $this->getContainer()->get(MediaConfig::class),
   317	            ),
   318	        );
   319	    }
   320	
   321	    private function conversionByType(
   322	        MediaConversionUrlCollection $conversions,
   323	        MediaImageConversionType|MediaVideoConversionType|MediaAudioConversionType $type,
   324	    ): MediaConversionUrl {
   325	        $conversion = $conversions->ofType($type);
   326	        self::assertNotNull($conversion, \sprintf('Конверсия типа %s не найдена в результате.', $type->value));
   327	
   328	        return $conversion;
   329	    }
   330	}

