     5	namespace App\Shared\Infrastructure\Configuration\Media;
     6	
     7	use App\Shared\Infrastructure\Configuration\TypedConfig;
     8	use App\Shared\Infrastructure\Exception\InvalidConfigValueException;
     9	
    10	final readonly class MediaConfig implements TypedConfig
    11	{
    12	    public static function configName(): string
    13	    {
    14	        return 'media';
    15	    }
    16	
    17	    public function __construct(
    18	        public int $stagingTtlSeconds,
    19	        public int $multipartThresholdBytes,
    20	        public int $multipartPartSizeBytes,
    21	        public string $imageProcessingDriver,
    22	        public string $ffmpegBinaryPath,
    23	        public string $ffprobeBinaryPath,
    24	        public int $ffmpegTimeoutSeconds,
    25	        public int $ffmpegThreads,
    26	        public int $presignedTtlSeconds,
    27	    ) {
    28	        // Порог multipart должен быть не меньше размера части: иначе файл чуть больше порога,
    29	        // но меньше одной части ушёл бы в multipart с единственной частью — это бессмысленно
    30	        // относительно одиночного PUT и потенциально нарушает лимит S3 ≥ 5 MiB на часть.
    31	        if ($multipartThresholdBytes < $multipartPartSizeBytes) {
    32	            throw new InvalidConfigValueException(
    33	                path: 'media.multipartThresholdBytes',
    34	                expected: \sprintf('>= multipartPartSizeBytes (%d)', $multipartPartSizeBytes),
    35	                actual: (string) $multipartThresholdBytes,
    36	            );
    37	        }
    38	
    39	        // Верхняя граница срока presigned-ссылки скачивания: значение больше 7 суток (604800)
    40	        // принимает конфиг (\max(1, ...) обрезает только снизу), но MediaPresignedTtl::fromInt его
    41	        // отвергнет — и приложение, стартовав, падало бы с 500 на каждом построении ссылки для
    42	        // приватного медиа. Поэтому отказываем сразу при старте. Граница 604800 продублирована из
    43	        // MediaPresignedTtl::MAX — держать синхронно с ним: при изменении максимума в VO обновить и
    44	        // это значение. Прямой импорт VO ради ::MAX недопустим (константа protected и завёл бы
    45	        // зависимость Shared/Infrastructure → Modules/Media/Domain), поэтому связь держим комментарием.
    46	        if ($presignedTtlSeconds > 604_800) {
    47	            throw new InvalidConfigValueException(
    48	                path: 'media.presignedTtlSeconds',
    49	                expected: '<= 604800',
    50	                actual: (string) $presignedTtlSeconds,
    51	            );
    52	        }
    53	    }
    54	}

