     5	namespace App\Modules\Posts\Domain\Entity;
     6	
     7	use App\Modules\Media\Domain\Entity\Media;
     8	use App\Modules\Posts\Domain\ValueObject\MediaPosition;
     9	use App\Modules\Posts\Domain\ValueObject\PostId;
    10	use App\Modules\Posts\Domain\ValueObject\PostMediaId;
    11	use App\Modules\Posts\Domain\ValueObject\PostMediaReference;
    12	use App\Modules\Posts\Repository\PostMediaRepository;
    13	use App\Shared\Domain\Trait\HasTimestamps;
    14	use App\Shared\Infrastructure\Cycle\ValueObjectCast;
    15	use Cycle\Annotated\Annotation\Column;
    16	use Cycle\Annotated\Annotation\Entity;
    17	use Cycle\Annotated\Annotation\Relation\BelongsTo;
    18	use Cycle\ORM\Parser\Typecast;
    19	
    20	#[Entity(
    21	    role: 'post_media',
    22	    table: 'post_media',
    23	    repository: PostMediaRepository::class,
    24	    typecast: [Typecast::class, ValueObjectCast::class],
    25	)]
    26	final class PostMedia
    27	{
    28	    use HasTimestamps;
    29	
    30	    #[Column(type: 'uuid', primary: true, typecast: PostMediaId::class)]
    31	    public private(set) PostMediaId $id;
    32	
    33	    #[Column(type: 'uuid', name: 'post_id', typecast: PostId::class)]
    34	    public private(set) PostId $postId;
    35	
    36	    #[Column(type: 'uuid', name: 'media_id', typecast: PostMediaReference::class)]
    37	    public private(set) PostMediaReference $mediaId;
    38	
    39	    #[Column(type: 'integer', typecast: MediaPosition::class)]
    40	    public private(set) MediaPosition $position;
    41	
    42	    #[BelongsTo(target: Post::class, innerKey: 'post_id', outerKey: 'id', fkOnDelete: 'CASCADE')]
    43	    public private(set) Post $post;
    44	
    45	    /**
    46	     * Ссылка на медиа модуля Media. Media — универсальный (foundational) модуль, на сущности которого
    47	     * другим модулям разрешено держать relation на чтение (см. docs/arch.md). cascade: false — Posts
    48	     * не сохраняет и не меняет Media; fkCreate/indexCreate: false — FK media_id уже создан миграцией
    49	     * post_media, повторно его не заводим. Запись идёт по колонке mediaId, связь — для eager-load при
    50	     * сборке URL: лента строит оригинал через MediaUrlService::getOriginalUrl, а getUrls — общий путь
    51	     * полного набора (оригинал + конверсии, например для FindMediaUrl). Доступ без eager-load вызовет
    52	     * ленивую подгрузку.
    53	     *
    54	     * create() эту связь НЕ инициализирует (в отличие от $post): вложение записывается по колонке mediaId,
    55	     * а сама сущность Media в сценарии создания недоступна (вызывающий держит только идентификатор). Поэтому
    56	     * $media безопасен лишь после ORM-гидрации — чтение через PostMediaRepository с eager-load media.*;
    57	     * обращение к ->media на только что созданном через create() экземпляре до гидрации бросит Error
    58	     * (свойство non-nullable без значения по умолчанию).
    59	     *
    60	     * Устойчивость ленты к отсутствующей строке медиа держится на инварианте схемы, а не на коде: FK
    61	     * media_id стоит с ON DELETE RESTRICT (миграция post_media), поэтому используемое медиа нельзя удалить
    62	     * и связь у гидрированной строки всегда разрешается. Ослабление инварианта (снятие RESTRICT, жёсткое
    63	     * удаление в обход Media-сценария, ручная чистка данных) оставит осиротевший media_id, и обращение к
    64	     * ->media уронит чтение ленты — защита здесь на схеме БД, а не на проверке в коде.
    65	     */
    66	    #[BelongsTo(
    67	        target: Media::class,
    68	        innerKey: 'media_id',
    69	        outerKey: 'id',
    70	        cascade: false,
    71	        fkCreate: false,
    72	        indexCreate: false,
    73	    )]
    74	    public private(set) Media $media;
    75	
    76	    public static function create(Post $post, PostMediaReference $mediaId, MediaPosition $position): self
    77	    {
    78	        $postMedia = new self();
    79	        $postMedia->id = PostMediaId::generate();
    80	        $postMedia->post = $post;
    81	        $postMedia->postId = $post->id;
    82	        $postMedia->mediaId = $mediaId;
    83	        $postMedia->position = $position;
    84	        $postMedia->initializeTimestamps();
    85	
    86	        return $postMedia;
    87	    }
    88	}

