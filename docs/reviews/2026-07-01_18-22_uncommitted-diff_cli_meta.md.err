     5	namespace App\Modules\User\Application\Profile;
     6	
     7	use App\Modules\Media\Application\Query\FindMediaOriginalUrl\FindMediaOriginalUrlHandler;
     8	use App\Modules\Media\Application\Query\FindMediaOriginalUrl\FindMediaOriginalUrlQuery;
     9	use App\Modules\User\Application\Dto\UserPublicProfileView;
    10	use App\Modules\User\Domain\Entity\User;
    11	use GianTiaga\SpiralCqrs\QueryBusInterface;
    12	
    13	/**
    14	 * Собирает публичный профиль из доменной сущности User, разрешая ссылку на аватар через модуль
    15	 * Media. Аватар всегда непустой: если у пользователя нет аватара или его медиа недоступно
    16	 * (удалено/не готово) — подставляется готовая ссылка на аватар по умолчанию (её передаёт
    17	 * Infrastructure при сборке ассемблера, источник Application не знает).
    18	 *
    19	 * Используется FindMediaOriginalUrl (только оригинал, без подгрузки и подписания конверсий): для
    20	 * аватара нужна одна ссылка, а в листингах профилей сборка вызывается на каждого пользователя, поэтому
    21	 * лишние загрузки связей конверсий множились бы на число пользователей.
    22	 *
    23	 * Межмодульный Query идёт через QueryBus: шина возвращает ровно тип Handler::handle()
    24	 * (MediaUrlResult|null), поэтому контракт «медиа недоступно -> null -> значение по умолчанию»
    25	 * сохраняется без try-catch, а middleware обработчика (в том числе #[LogOperation]) работает.
    26	 */
    27	final readonly class UserPublicProfileAssembler
    28	{
    29	    public function __construct(
    30	        private QueryBusInterface $queryBus,
    31	        private FindMediaOriginalUrlHandler $findMediaOriginalUrlHandler,
    32	        private string $defaultAvatarUrl,
    33	    ) {}
    34	
    35	    public function fromUser(User $user): UserPublicProfileView
    36	    {
    37	        return new UserPublicProfileView(
    38	            userId: $user->id->value(),
    39	            name: $user->name->value(),
    40	            avatarUrl: $this->resolveAvatarUrl($user),
    41	            locale: $user->locale->value,
    42	        );
    43	    }
    44	
    45	    private function resolveAvatarUrl(User $user): string
    46	    {
    47	        $mediaId = $user->avatar->value();
    48	
    49	        if ($mediaId === null) {
    50	            return $this->defaultAvatarUrl;
    51	        }
    52	
    53	        $originalUrl = $this->queryBus->dispatch(
    54	            query: new FindMediaOriginalUrlQuery(mediaId: $mediaId),
    55	            handler: $this->findMediaOriginalUrlHandler->handle(...),
    56	        );
    57	
    58	        // Если медиа недоступно или оригинал удалён (readyOriginalRemoved) — null, подставляем
    59	        // значение по умолчанию.
    60	        if ($originalUrl === null) {
    61	            return $this->defaultAvatarUrl;
    62	        }
    63	
    64	        return $originalUrl->url;
    65	    }
    66	}
