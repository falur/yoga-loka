     2	
     3	declare(strict_types=1);
     4	
     5	namespace App\Modules\Media\Application\Query\GetAudioWaveform;
     6	
     7	use App\Modules\Media\Domain\Enum\MediaType;
     8	use App\Modules\Media\Domain\ValueObject\MediaId;
     9	use App\Modules\Media\Domain\ValueObject\MediaWaveform;
    10	use App\Modules\Media\Repository\MediaAudioConversionRepository;
    11	use App\Modules\Media\Repository\MediaRepository;
    12	use App\Shared\Domain\Exception\NotFoundException;
    13	
    14	/**
    15	 * Возвращает волну амплитуд нормализованной аудио-конверсии (числа для прогресса воспроизведения).
    16	 * Волна не отдаётся через URL — это отдельный запрос. Медиа не финализировано (не ready и не
    17	 * readyOriginalRemoved) / не аудио / без конверсии — 404.
    18	 */
    19	final readonly class GetAudioWaveformHandler
    20	{
    21	    public function __construct(
    22	        private MediaRepository $mediaRepository,
    23	        private MediaAudioConversionRepository $mediaAudioConversionRepository,
    24	    ) {}
    25	
    26	    public function handle(GetAudioWaveformQuery $query): MediaWaveform
    27	    {
    28	        $media = $this->mediaRepository->findById(MediaId::fromString($query->mediaId))
    29	            ?? throw new NotFoundException('app.media.not_found');
    30	
    31	        // Волна — это конверсия, поэтому переживает удаление оригинала (ready и readyOriginalRemoved).
    32	        if (!$media->isFinalized()) {
    33	            throw new NotFoundException('app.media.not_ready');
    34	        }
    35	
    36	        if ($media->type !== MediaType::Audio) {
    37	            throw new NotFoundException('app.media.conversion_not_found');
    38	        }
    39	
    40	        // Каталог аудио-типов содержит ровно один профиль (NormalizedAacM4a) и на медиа не больше
    41	        // одной такой конверсии, поэтому берём первую без фильтра по единственному типу.
    42	        $conversion = $this->mediaAudioConversionRepository->findByMediaId($media->id)->first()
    43	            ?? throw new NotFoundException('app.media.conversion_not_found');
    44	
    45	        return $conversion->waveform;
    46	    }
    47	}

