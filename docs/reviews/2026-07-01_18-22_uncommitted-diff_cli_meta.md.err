   128	
   129	    public function testFindByUserIdFiltersStatusAndPaginates(): void
   130	    {
   131	        $user = $this->createUser();
   132	        $this->persist($user);
   133	        $other = $this->createUser();
   134	        $this->persist($other);
   135	
   136	        $created = [];
   137	        for ($index = 0; $index < 3; $index++) {
   138	            $post = $this->newPost($user->id, PostStatus::Published);
   139	            $this->persist($post);
   140	            $created[] = $post;
   141	        }
   142	
   143	        $blocked = $this->newPost($user->id, PostStatus::Blocked);
   144	        $this->persist($blocked);
   145	
   146	        // Чужая запись не попадает в выборку получателя.
   147	        $this->persist($this->newPost($other->id, PostStatus::Published));
   148	        $this->cleanOrmHeap();
   149	
   150	        $publishedIdsDesc = $this->idsDesc($created);
   151	
   152	        $firstPage = $this->postRepository()->findByUserId($user->id, PostStatus::Published, null, 2);
   153	        self::assertSame(\array_slice($publishedIdsDesc, 0, 2), $this->ids($firstPage->all()));
   154	
   155	        $lastOnFirstPage = $firstPage->last();
   156	        self::assertInstanceOf(Post::class, $lastOnFirstPage);
   157	
   158	        $secondPage = $this->postRepository()->findByUserId($user->id, PostStatus::Published, $lastOnFirstPage->id, 2);
   159	        self::assertSame(\array_slice($publishedIdsDesc, 2), $this->ids($secondPage->all()));
   160	
   161	        $emptyPage = $this->postRepository()->findByUserId($user->id, PostStatus::Published, $secondPage->last()?->id, 2);
   162	        self::assertCount(0, $emptyPage);
   163	
   164	        // Без фильтра статуса возвращаются и Published, и Blocked.
   165	        self::assertCount(4, $this->postRepository()->findByUserId($user->id, null, null, 10));
   166	        self::assertCount(1, $this->postRepository()->findByUserId($user->id, PostStatus::Blocked, null, 10));
   167	    }
