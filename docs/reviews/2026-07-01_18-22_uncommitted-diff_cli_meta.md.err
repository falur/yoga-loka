    23	    public function testStoresAndRestoresMediaOrderedByPosition(): void
    24	    {
    25	        $user = $this->createUser();
    26	        $this->persist($user);
    27	        $firstMedia = $this->createMedia($user->id);
    28	        $this->persist($firstMedia);
    29	        $secondMedia = $this->createMedia($user->id);
    30	        $this->persist($secondMedia);
    31	
    32	        $post = $this->newPost($user->id);
    33	        $this->persist($post);
    34	
    35	        // Намеренно вставляем во втором/первом порядке, чтобы проверить orderBy position ASC.
    36	        $this->persist(PostMedia::create(
    37	            post: $post,
    38	            mediaId: PostMediaReference::fromString($secondMedia->id->value()),
    39	            position: MediaPosition::fromInt(1),
    40	        ));
    41	        $this->persist(PostMedia::create(
    42	            post: $post,
    43	            mediaId: PostMediaReference::fromString($firstMedia->id->value()),
    44	            position: MediaPosition::fromInt(0),
    45	        ));
    46	        $this->cleanOrmHeap();
    47	
    48	        $attachments = $this->postMediaRepository()->findByPostId($post->id);
    49	
    50	        self::assertInstanceOf(PostMediaCollection::class, $attachments);
    51	        self::assertCount(2, $attachments);
    52	        self::assertSame(0, $attachments->first()?->position->value());
    53	        self::assertSame($firstMedia->id->value(), $attachments->first()?->mediaId->value());
    54	
    55	        $restoredPost = $this->postRepository()->findById($post->id);
    56	        self::assertInstanceOf(Post::class, $restoredPost);
    57	        self::assertCount(2, $restoredPost->media);
    58	        self::assertSame(0, $restoredPost->media->first()?->position->value());
    59	    }
