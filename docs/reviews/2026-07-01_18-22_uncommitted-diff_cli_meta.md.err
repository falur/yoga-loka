   115	        $this->persist($user);
   116	
   117	        $post = $this->newPost($user->id);
   118	        $post->softDelete(new \DateTimeImmutable('2026-06-17 10:00:00'));
   119	        $this->persist($post);
   120	        $this->cleanOrmHeap();
   121	
