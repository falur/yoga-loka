     2	
     3	declare(strict_types=1);
     4	
     5	namespace App\Modules\Media\Application\Service;
     6	
     7	use App\Modules\Media\Domain\ValueObject\MediaId;
     8	use App\Modules\Media\Repository\MediaAudioConversionRepository;
     9	use App\Modules\Media\Repository\MediaImageConversionRepository;
    10	use App\Modules\Media\Repository\MediaVideoConversionRepository;
    11	
    12	/**
    13	 * Отвечает на вопрос «есть ли у медиа хотя бы одна готовая (Ready) конверсия любого вида
    14	 * (image/video/audio)». Не-Ready строки (processing/processingFailed) не считаются: пригодной для
    15	 * отдачи конверсии у них нет, поэтому потребитель (например удаление оригинала) не должен считать их
    16	 * за «есть конверсия». Собирает знание обо всех видах конверсий в одном месте, чтобы вызывающий
    17	 * сценарий не зависел от каждого репозитория конверсий по отдельности: при добавлении нового вида
    18	 * конверсии правка остаётся здесь, а не в каждом обработчике.
    19	 *
    20	 * Ленивая проверка с ранним выходом на первой найденной конверсии: existsReadyForMediaId считает строки
    21	 * без гидрации сущностей — до трёх count-запросов на вызов.
    22	 */
    23	final readonly class MediaConversionsChecker
    24	{
    25	    public function __construct(
    26	        private MediaImageConversionRepository $mediaImageConversionRepository,
    27	        private MediaVideoConversionRepository $mediaVideoConversionRepository,
    28	        private MediaAudioConversionRepository $mediaAudioConversionRepository,
    29	    ) {}
    30	
    31	    public function hasAnyReadyConversion(MediaId $mediaId): bool
    32	    {
    33	        return $this->mediaImageConversionRepository->existsReadyForMediaId($mediaId)
    34	            || $this->mediaVideoConversionRepository->existsReadyForMediaId($mediaId)
    35	            || $this->mediaAudioConversionRepository->existsReadyForMediaId($mediaId);
    36	    }
    37	}
