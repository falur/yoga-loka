    28	    public function testReturnsRealAvatarUrlWhenMediaReady(): void
    29	    {
    30	        $media = $this->persistReadyPublicMedia();
    31	        $user = $this->persistUser(avatar: UserAvatar::pointingTo($media->id->value()));
    32	
    33	        $view = $this->handler()->handle(new GetUserPublicProfileQuery($user->id->value()));
    34	
    35	        self::assertSame(self::STUBBED_AVATAR_URL, $view->avatarUrl);
