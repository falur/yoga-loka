    32	final class PostRepositoryTest extends PostsRepositoryTestCase
    33	{
    34	    public function testStoresAndRestoresPostWithValueObjects(): void
    35	    {
    36	        $user = $this->createUser();
    37	        $this->persist($user);
    38	
    39	        $lessonId = (string) PostId::generate();
    40	        $post = $this->newPost($user->id, PostStatus::Published, PostText::fromString('Текст записи'));
    41	        $post->setLesson(PostLesson::pointingTo($lessonId));
    42	        $post->incrementLikes();
    43	        $post->incrementReposts();
    44	        $post->incrementComments();
    45	        $this->persist($post);
    46	        $this->cleanOrmHeap();
    47	
    48	        $restored = $this->postRepository()->findById($post->id);
    49	
    50	        self::assertInstanceOf(Post::class, $restored);
    51	        self::assertTrue($post->id->equals($restored->id));
    52	        self::assertTrue($user->id->equals($restored->userId));
    53	        self::assertSame('Текст записи', $restored->text->value());
    54	        self::assertSame(PostStatus::Published, $restored->status);
    55	        self::assertSame(AttachmentType::Lesson, $restored->attachmentType);
    56	        self::assertSame($lessonId, $restored->lesson->value());
    57	        self::assertTrue($restored->practice->isEmpty());
    58	        self::assertSame(1, $restored->likesCount->value());
    59	        self::assertSame(1, $restored->repostsCount->value());
    60	        self::assertSame(1, $restored->commentsCount->value());
    61	        self::assertFalse($restored->deletion->isDeleted());
    62	    }
