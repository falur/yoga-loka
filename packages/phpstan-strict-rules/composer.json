{
    "name": "gian-tiaga/phpstan-strict-rules",
    "type": "library",
    "license": "MIT",
    "description": "Strict PHPStan rules for PHP applications",
    "authors": [
        {
            "name": "Ildar Enakaev",
            "email": "ienakaev@ya.ru"
        }
    ],
    "require": {
        "php": ">=8.5 <8.6",
        "phpstan/phpstan": "^2.1.54"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "GianTiaga\\PhpStanStrictRules\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GianTiaga\\PhpStanStrictRules\\Tests\\": "tests"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "spiral/composer-publish-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
