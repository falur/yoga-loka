{
    "name": "gian-tiaga/spiral-api-errors",
    "type": "library",
    "license": "MIT",
    "description": "API error handling package for typed Spiral HTTP layers",
    "authors": [
        {
            "name": "Ildar Enakaev",
            "email": "ienakaev@ya.ru"
        }
    ],
    "require": {
        "php": ">=8.5 <8.6",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "gian-tiaga/spiral-openapi": "dev-main",
        "spiral/framework": "^3.16"
    },
    "require-dev": {
        "gian-tiaga/phpstan-strict-rules": "*",
        "phpstan/phpstan": "^2.1.54",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "GianTiaga\\SpiralApiErrors\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GianTiaga\\SpiralApiErrors\\Tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../spiral-openapi",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../phpstan-strict-rules",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "spiral/composer-publish-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
