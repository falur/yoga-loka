{
    "name": "gian-tiaga/spiral-openapi",
    "type": "library",
    "license": "MIT",
    "description": "Static OpenAPI generator for typed Spiral HTTP layers",
    "authors": [
        {
            "name": "Ildar Enakaev",
            "email": "ienakaev@ya.ru"
        }
    ],
    "require": {
        "php": ">=8.5 <8.6",
        "nyholm/psr7": "^1.8",
        "nikic/php-parser": "^5.7",
        "phpstan/phpdoc-parser": "^2.3",
        "spiral/framework": "^3.16",
        "symfony/finder": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "gian-tiaga/phpstan-strict-rules": "*",
        "phpstan/phpstan": "^2.1.54",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "GianTiaga\\SpiralOpenApi\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GianTiaga\\SpiralOpenApi\\Tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../phpstan-strict-rules",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "spiral/composer-publish-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
