includes:
    - vendor/gian-tiaga/phpstan-strict-rules/extension.neon
    - vendor/gian-tiaga/spiral-cqrs/extension.neon
    - vendor/gian-tiaga/spiral-openapi/extension.neon

parameters:
    level: max
    # Интерфейс-маркер санкционированной массовой записи: пакет правил не знает классов
    # приложения, поэтому имя маркера объявляет сам проект.
    setBasedWriteMarkerInterface: 'App\Shared\Infrastructure\Persistence\Cycle\SetBasedWrite'
    tmpDir: runtime/phpstan
    paths:
        - app/src
    phpVersion: 80506
    bootstrapFiles:
        - vendor/autoload.php
    ignoreErrors:
        # \Normalizer::normalize() вызывается позиционно с явной формой FORM_C.
        # Именовать аргументы нельзя: имя первого параметра расходится между нативным
        # ext-intl ($string) и стабом symfony/polyfill-intl-normalizer ($s), поэтому
        # named-arguments-правило для этих двух строк погашено точечно.
        -
            identifier: gianTiaga.phpstanStrictRules.namedArgumentsRequired
            message: '#Calls with two or more ordinary arguments must use named arguments\.#'
            paths:
                - app/src/Modules/User/Domain/ValueObject/UserName.php
                - app/src/Modules/User/Domain/ValueObject/UserSpiritualName.php
        # PSR-7 ServerRequestInterface::withAttribute объявляет первый параметр как $name, но
        # реализации (Nyholm — $attribute) расходятся в имени, поэтому named arguments вызвали бы
        # ошибку рантайма — здесь допустимы позиционные аргументы.
        -
            identifier: gianTiaga.phpstanStrictRules.namedArgumentsRequired
            message: '#Calls with two or more ordinary arguments must use named arguments\.#'
            paths:
                - app/src/Modules/Auth/Infrastructure/Spiral/Http/Middleware/AuthContextAttributeMiddleware.php
        # Cycle объявляет ключи RelationMap::getRelations() как non-empty-string, но PHP
        # приводит числовое имя связи к int. Проверка \is_string() защищает от этого случая
        # и покрыта тестом LazyGhostEntityFactoryTest::testExtractRelationsSkipsNonStringRelationName.
        -
            identifier: function.alreadyNarrowedType
            message: '#Call to function is_string\(\) with non-empty-string will always evaluate to true\.#'
            paths:
                - app/src/Shared/Infrastructure/Persistence/Cycle/LazyGhostEntityFactory.php
