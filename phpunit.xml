<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         backupGlobals="false"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         stopOnError="false"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         stderr="true"
         cacheDirectory="runtime/.phpunit.cache"
         backupStaticProperties="false"
>
    <coverage/>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
            <directory suffix="Test.php">app/src/Modules/Access/Tests/Unit</directory>
            <directory suffix="Test.php">app/src/Modules/Auth/Tests/Unit</directory>
            <directory suffix="Test.php">app/src/Modules/Media/Tests/Unit</directory>
            <directory suffix="Test.php">app/src/Modules/Notifications/Tests/Unit</directory>
            <directory suffix="Test.php">app/src/Modules/Outbox/Tests/Unit</directory>
            <directory suffix="Test.php">app/src/Modules/Posts/Tests/Unit</directory>
            <directory suffix="Test.php">app/src/Modules/Tags/Tests/Unit</directory>
            <directory suffix="Test.php">app/src/Modules/User/Tests/Unit</directory>
        </testsuite>
        <testsuite name="Kernel">
            <directory suffix="Test.php">tests/Kernel</directory>
            <directory suffix="Test.php">app/src/Modules/Access/Tests/Integration</directory>
            <directory suffix="Test.php">app/src/Modules/Auth/Tests/Integration</directory>
            <directory suffix="Test.php">app/src/Modules/Media/Tests/Integration</directory>
            <directory suffix="Test.php">app/src/Modules/Notifications/Tests/Integration</directory>
            <directory suffix="Test.php">app/src/Modules/Outbox/Tests/Integration</directory>
            <directory suffix="Test.php">app/src/Modules/Posts/Tests/Integration</directory>
            <directory suffix="Test.php">app/src/Modules/System/Tests/Integration</directory>
            <directory suffix="Test.php">app/src/Modules/Tags/Tests/Integration</directory>
            <directory suffix="Test.php">app/src/Modules/User/Tests/Integration</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">tests/Feature</directory>
            <directory suffix="Test.php">app/src/Modules/Auth/Tests/Feature</directory>
            <directory suffix="Test.php">app/src/Modules/Notifications/Tests/Feature</directory>
            <directory suffix="Test.php">app/src/Modules/Posts/Tests/Feature</directory>
            <directory suffix="Test.php">app/src/Modules/System/Tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">app/src</directory>
        </include>
        <exclude>
            <directory>app/src/Modules/Access/Tests</directory>
            <directory>app/src/Modules/Auth/Tests</directory>
            <directory>app/src/Modules/Media/Tests</directory>
            <directory>app/src/Modules/Notifications/Tests</directory>
            <directory>app/src/Modules/Outbox/Tests</directory>
            <directory>app/src/Modules/Posts/Tests</directory>
            <directory>app/src/Modules/System/Tests</directory>
            <directory>app/src/Modules/Tags/Tests</directory>
            <directory>app/src/Modules/User/Tests</directory>
        </exclude>
    </source>
    <php>
        <env name="DB_CONNECTION" value="pgsql" />
        <env name="DB_LOG_QUERY_PARAMETERS" value="true" />
        <!-- DB_DATABASE, S3_BUCKET, S3_TEST_BUCKET задаёт tests/bootstrap.php по TEST_TOKEN. -->
        <env name="DB_HOST" value="postgres" />
        <env name="DB_PORT" value="5432" />
        <env name="DB_USERNAME" value="postgres" />
        <env name="DB_PASSWORD" value="password" />
        <env name="CYCLE_SCHEMA_CACHE" value="true" />
        <env name="QUEUE_CONNECTION" value="sync" />
        <env name="CACHE_STORAGE" value="local" />
        <env name="SESSION_CACHE_STORAGE" value="local" />
        <env name="SCHEDULER_MUTEX_CACHE_STORAGE" value="local" />
        <env name="REDIS_DSN" value="redis://redis:6379/0" />
        <env name="STORAGE_DEFAULT" value="s3-test" />
        <env name="S3_KEY" value="yoga_loka" />
        <env name="S3_SECRET" value="yoga_loka_password" />
        <env name="S3_ENDPOINT" value="http://minio:9000" />
        <env name="MEDIA_UPLOAD_STORAGE_PREFIX" value="test" />
        <env name="MEDIA_PRIVATE_STORAGE_PREFIX" value="test" />
        <env name="MEDIA_PUBLIC_STORAGE_PREFIX" value="test" />
        <env name="MEDIA_STAGING_TTL_SECONDS" value="86400" />
        <env name="MEDIA_PRESIGNED_TTL_SECONDS" value="3600" />
        <env name="MEDIA_MULTIPART_THRESHOLD_BYTES" value="16777216" />
        <env name="MEDIA_MULTIPART_PART_SIZE_BYTES" value="8388608" />
        <env name="MEDIA_IMAGE_PROCESSING_DRIVER" value="imagick" />
        <env name="MEDIA_FFMPEG_BINARY" value="/usr/bin/ffmpeg" />
        <env name="MEDIA_FFPROBE_BINARY" value="/usr/bin/ffprobe" />
        <env name="MEDIA_FFMPEG_TIMEOUT_SECONDS" value="1800" />
        <env name="MEDIA_FFMPEG_THREADS" value="0" />
        <env name="MAILER_DSN" value="smtp://mailpit:1025" />
        <env name="TEMPORAL_ADDRESS" value="temporal:7233" />
        <env name="TEMPORAL_TASK_QUEUE" value="default" />
        <env name="CENTRIFUGO_API_URL" value="http://centrifugo:8000/api" />
        <env name="APP_ENV" value="testing" />
        <env name="TOKENIZER_CACHE_TARGETS" value="true" />
        <env name="TELEMETRY_DRIVER" value="null" />
        <env name="BROADCAST_DRIVER" value="log" />
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="-1"/>
    </php>
</phpunit>
