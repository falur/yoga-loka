{
    "name": "yoga-loka/api-error-tools",
    "type": "library",
    "license": "MIT",
    "description": "API error handling tools for typed Spiral HTTP layers",
    "require": {
        "php": ">=8.5 <8.6",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "spiral/framework": "^3.16",
        "yoga-loka/openapi-tools": "dev-main"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.54",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "Tools\\ApiError\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tools\\ApiError\\Tests\\": "tests"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../openapi",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "phpstan": "../../vendor/bin/phpstan analyse",
        "test": "../../vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
