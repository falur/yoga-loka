<?php

declare(strict_types=1);

namespace Tools\Cqrs\Tests\PHPStan\Fixtures;

use Tools\Cqrs\Attribute\Transactional;
use Tools\Cqrs\CommandBusInterface;
use Tools\Cqrs\QueryBusInterface;

function forbiddenClosureHandler(
    CommandBusInterface $commandBus,
    ForbiddenCommandHandler $forbiddenCommandHandler,
): void {
    $commandBus->dispatch(
        command: new ForbiddenCommand(value: 'closure'),
        handler: static fn(ForbiddenCommand $command): string => $forbiddenCommandHandler->handle($command),
    );
}

function forbiddenArrayCallableHandler(
    CommandBusInterface $commandBus,
    ForbiddenCommandHandler $forbiddenCommandHandler,
): void {
    $commandBus->dispatch(
        command: new ForbiddenCommand(value: 'array'),
        handler: [$forbiddenCommandHandler, 'handle'],
    );
}

function forbiddenObjectHandler(
    CommandBusInterface $commandBus,
    InvokableForbiddenCommandHandler $invokableForbiddenCommandHandler,
): void {
    $commandBus->dispatch(
        command: new ForbiddenCommand(value: 'object'),
        handler: $invokableForbiddenCommandHandler,
    );
}

function forbiddenTransactionalQueryHandler(
    QueryBusInterface $queryBus,
    TransactionalQueryHandler $transactionalQueryHandler,
): void {
    $queryBus->dispatch(
        query: new ForbiddenQuery(value: 'query'),
        handler: $transactionalQueryHandler->handle(...),
    );
}

final readonly class ForbiddenCommand
{
    public function __construct(
        public string $value,
    ) {}
}

final readonly class ForbiddenQuery
{
    public function __construct(
        public string $value,
    ) {}
}

final readonly class ForbiddenCommandHandler
{
    public function handle(ForbiddenCommand $command): string
    {
        return $command->value;
    }
}

final readonly class InvokableForbiddenCommandHandler
{
    public function __invoke(ForbiddenCommand $command): string
    {
        return $command->value;
    }
}

final readonly class TransactionalQueryHandler
{
    #[Transactional]
    public function handle(ForbiddenQuery $query): string
    {
        return $query->value;
    }
}
