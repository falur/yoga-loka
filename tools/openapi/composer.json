{
    "name": "yoga-loka/openapi-tools",
    "type": "library",
    "license": "MIT",
    "description": "Static OpenAPI generator for typed Spiral HTTP layers",
    "require": {
        "php": ">=8.5 <8.6",
        "nyholm/psr7": "^1.8",
        "nikic/php-parser": "v5.7.0",
        "phpstan/phpdoc-parser": "2.3.2",
        "spiral/framework": "^3.16",
        "symfony/finder": "v8.0.8",
        "symfony/yaml": "v8.0.10"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.54",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "Tools\\OpenApi\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tools\\OpenApi\\Tests\\": "tests"
        }
    },
    "scripts": {
        "phpstan": "../../vendor/bin/phpstan analyse",
        "test": "../../vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
